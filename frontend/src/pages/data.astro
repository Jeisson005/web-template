---
import BaseLayout from '@/layouts/BaseLayout.astro';
import FaqAccordion from '@/components/FaqAccordion.astro';
import ContactSection from '@/components/ContactSection.astro';

const dataFaqs = [
  {
    q: '¿Qué cobertura geográfica existe?',
    a: 'Equipos propios en 10 países de las Américas y clientes en más de 15. La cobertura de cada capa se confirma por país al definir el alcance de la suscripción.',
  },
  {
    q: '¿Con qué frecuencia se actualizan las capas?',
    a: 'La frecuencia de actualización depende de la capa: las variables sociodemográficas se revisan anualmente, mientras que los POIs y movilidad pueden tener actualizaciones trimestrales o semestrales según el territorio.',
  },
  {
    q: '¿Cómo se entrega la muestra?',
    a: 'Nos dices tu industria y el territorio, y entregamos una muestra de las capas que aplican a tu caso sobre ese territorio, no una vista genérica.',
  },
  {
    q: '¿Funciona con mi propio licenciamiento Esri?',
    a: 'Sí. Las capas se despliegan sobre el entorno Esri que el cliente ya tiene contratado. El cliente conserva su licenciamiento, sus datos y su entorno.',
  },
  {
    q: '¿Cómo se integra con Power BI?',
    a: 'Las capas se consumen por API o como productos para integración, y desde ahí se conectan a Power BI, CRM, ERP, bases de datos y ArcGIS.',
  },
];
---

<BaseLayout
  lang="es"
  title="smartmaps Data | Todo el territorio, listo para consumir"
  description="Múltiples capas de datos georreferenciados, actualizadas y validadas en campo, disponibles vía plataforma o API."
>
  <div style="background: rgb(255, 255, 255); color: rgb(10, 28, 78); font-family: 'Plus Jakarta Sans', sans-serif;">
    <!-- Hero Section -->
    <div
      style="background: radial-gradient(80% 100% at 74% 24%, rgb(18, 48, 140) 0%, rgb(10, 28, 78) 46%, rgb(5, 14, 43) 100%); color: rgb(234, 240, 251); padding: 104px 0px 112px;"
    >
      <div style="max-width: 1280px; margin: 0px auto; padding: 0px 40px;">
        <div style="max-width: 820px; margin-top: 14px;">
          <div
            style="display: inline-flex; align-items: center; gap: 10px; font-size: 12px; font-weight: 700; letter-spacing: 2.2px; color: rgb(111, 178, 255); text-transform: uppercase;"
          >
            <span style="padding: 4px 10px; border: 1px solid rgba(111, 178, 255, 0.4); border-radius: 9999px;">01</span>
            SMARTMAPS DATA
          </div>

          <h1
            style="margin: 20px 0px 0px; font-size: clamp(2rem, 1rem + 3.4vw, 4rem); line-height: 1.05; letter-spacing: -0.02em; font-weight: 800; color: #fff;"
          >
            Todo el territorio,<br />listo para consumir.
          </h1>
          <p
            style="margin: 24px 0px 0px; font-size: 1.125rem; line-height: 1.6; color: rgb(174, 195, 238); max-width: 68ch;"
          >
            Múltiples capas de datos georreferenciados, actualizadas y validadas en campo,<br />disponibles vía plataforma
            o API.
          </p>

          <div style="display: flex; flex-wrap: wrap; gap: 14px; margin-top: 44px;">
            <a
              href="#contacto"
              style="display: inline-flex; align-items: center; height: 48px; padding: 0px 24px; border-radius: 9999px; background: rgb(30, 123, 255); color: rgb(255, 255, 255); font-weight: 600;"
            >
              Solicita una muestra de datos
            </a>
            <a
              href="#niveles"
              style="display: inline-flex; align-items: center; height: 48px; padding: 0px 24px; border-radius: 9999px; border: 1px solid rgba(111, 178, 255, 0.5); color: rgb(234, 240, 251); font-weight: 600;"
            >
              Ver niveles de suscripción
            </a>
          </div>
        </div>
      </div>
    </div>

    <!-- Unidad de Análisis -->
    <div style="background: rgb(255, 255, 255); padding: 112px 0px;">
      <div style="max-width: 1280px; margin: 0px auto; padding: 0px 40px;">
        <div
          style="border-width: 1px 1px 1px 4px; border-style: solid; border-color: rgba(10, 23, 51, 0.08) rgba(10, 23, 51, 0.08) rgba(10, 23, 51, 0.08) rgb(30, 123, 255); border-image: none; border-radius: 24px; padding: 44px; display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 32px; align-items: center;"
        >
          <div>
            <div
              style="font-size: 0.75rem; font-weight: 700; letter-spacing: 0.14em; text-transform: uppercase; color: rgb(46, 124, 255);"
            >
              Unidad de análisis
            </div>
            <div
              style="margin-top: 16px; font-size: clamp(1.375rem, 1.1rem + 1vw, 1.75rem); line-height: 1.25; font-weight: 800; letter-spacing: -0.3px;"
            >
              Microdatos de mercado agregados a celda de 100 metros.
            </div>
            <div
              style="margin-top: 14px; font-size: 1.0625rem; line-height: 1.6; color: rgb(90, 108, 140); max-width: 60ch;"
            >
              Se consumen completos o por capa.
            </div>
          </div>
          <img
            src="https://i.postimg.cc/FzSL0Hd4/web-grid-ciudad.png"
            alt="Fragmento de ciudad con grilla de celdas de 100 metros y valores por celda"
            style="width: 100%; height: auto; display: block;"
          />
        </div>
      </div>
    </div>

    <!-- Capas + Tarjeta Extra -->
    <div id="capas" style="background: rgb(247, 250, 255); padding: 112px 0px;">
      <div style="max-width: 1280px; margin: 0px auto; padding: 0px 40px;">
        <div style="max-width: 68ch;">
          <div
            style="font-size: 0.75rem; font-weight: 700; letter-spacing: 0.14em; text-transform: uppercase; color: rgb(46, 124, 255);"
          >
            Capas de información
          </div>
          <h2
            style="margin: 14px 0px 0px; font-size: clamp(2rem, 1.2rem + 2.4vw, 3rem); line-height: 1.12; letter-spacing: -0.02em; font-weight: 800;"
          >
            Múltiples capas, una misma celda.
          </h2>
        </div>
        <div
          style="display: grid; grid-template-columns: repeat(auto-fit, minmax(260px, 1fr)); gap: 18px; margin-top: 48px;"
        >
          <div
            style="background: rgb(255, 255, 255); border: 1px solid rgba(10, 23, 51, 0.08); border-radius: 16px; padding: 26px; box-shadow: rgba(6, 13, 34, 0.04) 0px 1px 2px; transition: transform 0.2s, border-color 0.2s;"
          >
            <i class="ph ph-users-three" style="font-size: 26px; color: rgb(19, 73, 216);"></i>
            <div style="font-size: 17px; font-weight: 700; margin-top: 16px;">Sociodemografía</div>
            <div style="font-size: 1.0625rem; line-height: 1.6; color: rgb(90, 108, 140); margin-top: 8px;">
              Población, hogares, ingreso y consumo por celda.
            </div>
          </div>

          <div
            style="background: rgb(255, 255, 255); border: 1px solid rgba(10, 23, 51, 0.08); border-radius: 16px; padding: 26px; box-shadow: rgba(6, 13, 34, 0.04) 0px 1px 2px; transition: transform 0.2s, border-color 0.2s;"
          >
            <i class="ph ph-path" style="font-size: 26px; color: rgb(19, 73, 216);"></i>
            <div style="font-size: 17px; font-weight: 700; margin-top: 16px;">Movilidad</div>
            <div style="font-size: 1.0625rem; line-height: 1.6; color: rgb(90, 108, 140); margin-top: 8px;">
              Flujos de transeúntes y patrones de desplazamiento.
            </div>
          </div>

          <div
            style="background: rgb(255, 255, 255); border: 1px solid rgba(10, 23, 51, 0.08); border-radius: 16px; padding: 26px; box-shadow: rgba(6, 13, 34, 0.04) 0px 1px 2px; transition: transform 0.2s, border-color 0.2s;"
          >
            <i class="ph ph-map-pin" style="font-size: 26px; color: rgb(19, 73, 216);"></i>
            <div style="font-size: 17px; font-weight: 700; margin-top: 16px;">POIs</div>
            <div style="font-size: 1.0625rem; line-height: 1.6; color: rgb(90, 108, 140); margin-top: 8px;">
              Puntos de interés censados y clasificados.
            </div>
          </div>

          <div
            style="background: rgb(255, 255, 255); border: 1px solid rgba(10, 23, 51, 0.08); border-radius: 16px; padding: 26px; box-shadow: rgba(6, 13, 34, 0.04) 0px 1px 2px; transition: transform 0.2s, border-color 0.2s;"
          >
            <i class="ph ph-suitcase-rolling" style="font-size: 26px; color: rgb(19, 73, 216);"></i>
            <div style="font-size: 17px; font-weight: 700; margin-top: 16px;">Turismo</div>
            <div style="font-size: 1.0625rem; line-height: 1.6; color: rgb(90, 108, 140); margin-top: 8px;">
              Visitantes, estacionalidad y oferta turística.
            </div>
          </div>

          <div
            style="background: rgb(255, 255, 255); border: 1px solid rgba(10, 23, 51, 0.08); border-radius: 16px; padding: 26px; box-shadow: rgba(6, 13, 34, 0.04) 0px 1px 2px; transition: transform 0.2s, border-color 0.2s;"
          >
            <i class="ph ph-target" style="font-size: 26px; color: rgb(19, 73, 216);"></i>
            <div style="font-size: 17px; font-weight: 700; margin-top: 16px;">Atractividad comercial</div>
            <div style="font-size: 1.0625rem; line-height: 1.6; color: rgb(90, 108, 140); margin-top: 8px;">
              Índice de potencial por celda de 100 m.
            </div>
          </div>

          <div
            style="background: rgb(255, 255, 255); border: 1px solid rgba(10, 23, 51, 0.08); border-radius: 16px; padding: 26px; box-shadow: rgba(6, 13, 34, 0.04) 0px 1px 2px; transition: transform 0.2s, border-color 0.2s;"
          >
            <i class="ph ph-buildings" style="font-size: 26px; color: rgb(19, 73, 216);"></i>
            <div style="font-size: 17px; font-weight: 700; margin-top: 16px;">Entorno / Real Estate</div>
            <div style="font-size: 1.0625rem; line-height: 1.6; color: rgb(90, 108, 140); margin-top: 8px;">
              Uso de suelo, precios y entorno construido.
            </div>
          </div>

          <div
            style="background: rgb(255, 255, 255); border: 1px solid rgba(10, 23, 51, 0.08); border-radius: 16px; padding: 26px; box-shadow: rgba(6, 13, 34, 0.04) 0px 1px 2px; transition: transform 0.2s, border-color 0.2s;"
          >
            <i class="ph ph-storefront" style="font-size: 26px; color: rgb(19, 73, 216);"></i>
            <div style="font-size: 17px; font-weight: 700; margin-top: 16px;">Tejido empresarial</div>
            <div style="font-size: 1.0625rem; line-height: 1.6; color: rgb(90, 108, 140); margin-top: 8px;">
              Establecimientos, sectores y densidad de negocio.
            </div>
          </div>

          <!-- Tarjeta Extra: Otra capa -->
          <div
            style="background: rgb(255, 255, 255); border: 1px solid rgba(10, 23, 51, 0.08); border-radius: 16px; padding: 26px; box-shadow: rgba(6, 13, 34, 0.04) 0px 1px 2px; transition: transform 0.2s, border-color 0.2s; display: flex; flex-direction: column; justify-content: center; align-items: center; text-align: center;"
          >
            <i class="ph ph-question" style="font-size: 32px; color: rgb(19, 73, 216);"></i>
            <div style="font-size: 17px; font-weight: 700; margin-top: 16px; color: rgb(19, 73, 216);">
              ¿Necesitas otra capa?
            </div>
            <div style="font-size: 1.0625rem; line-height: 1.6; color: rgb(90, 108, 140); margin-top: 8px;">
              La levantamos en campo.
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- Captura de campo -->
    <div
      style="background: rgb(5, 14, 43); color: rgb(234, 240, 251); padding: 128px 0px; border-top: 1px solid rgba(255,255,255,0.05);"
    >
      <div style="max-width: 1280px; margin: 0px auto; padding: 0px 40px;">
        <div
          style="display: grid; grid-template-columns: repeat(auto-fit, minmax(320px, 1fr)); gap: 64px; align-items: stretch;"
        >
          <!-- Columna Izquierda -->
          <div style="display: flex; flex-direction: column;">
            <div
              style="font-size: 0.75rem; font-weight: 700; letter-spacing: 0.14em; text-transform: uppercase; color: rgb(74, 155, 255);"
            >
              Captura de campo
            </div>
            <h2
              style="margin: 14px 0px 0px; font-size: clamp(2rem, 1.2rem + 2.4vw, 3rem); line-height: 1.12; letter-spacing: -0.02em; font-weight: 800; color: rgb(255, 255, 255);"
            >
              Cuando la capa no existe, la levantamos.
            </h2>
            <p style="margin: 18px 0px 0px; font-size: 1.125rem; line-height: 1.6; color: rgb(174, 195, 238);">
              Equipos propios en terreno, formularios diseñados por proyecto y control de calidad sobre el dato en el
              momento en que se captura.
            </p>

            <div style="margin-top: 36px; display: flex; flex-direction: column;">
              <div
                style="display: flex; align-items: flex-start; gap: 14px; padding: 16px 0px; border-top: 1px solid rgba(255, 255, 255, 0.08);"
              >
                <i
                  class="ph ph-crosshair"
                  style="font-size: 24px; color: rgb(74, 155, 255); flex: 0 0 auto; margin-top: 2px;"></i>
                <div>
                  <div style="font-size: 1.0625rem; font-weight: 700; color: rgb(234, 240, 251);">
                    Captura georreferenciada de POIs
                  </div>
                  <div style="font-size: 1.0625rem; line-height: 1.6; color: rgb(147, 170, 207); margin-top: 4px;">
                    Puntos de interés censados y clasificados en terreno.
                  </div>
                </div>
              </div>
              <div
                style="display: flex; align-items: flex-start; gap: 14px; padding: 16px 0px; border-top: 1px solid rgba(255, 255, 255, 0.08);"
              >
                <i
                  class="ph ph-clipboard-text"
                  style="font-size: 24px; color: rgb(74, 155, 255); flex: 0 0 auto; margin-top: 2px;"></i>
                <div>
                  <div style="font-size: 1.0625rem; font-weight: 700; color: rgb(234, 240, 251);">
                    Encuestas y censos
                  </div>
                  <div style="font-size: 1.0625rem; line-height: 1.6; color: rgb(147, 170, 207); margin-top: 4px;">
                    Formularios personalizados por proyecto, con validación en campo.
                  </div>
                </div>
              </div>
              <div
                style="display: flex; align-items: flex-start; gap: 14px; padding: 16px 0px; border-top: 1px solid rgba(255, 255, 255, 0.08);"
              >
                <i
                  class="ph ph-camera"
                  style="font-size: 24px; color: rgb(74, 155, 255); flex: 0 0 auto; margin-top: 2px;"></i>
                <div>
                  <div style="font-size: 1.0625rem; font-weight: 700; color: rgb(234, 240, 251);">
                    Atributos enriquecidos
                  </div>
                  <div style="font-size: 1.0625rem; line-height: 1.6; color: rgb(147, 170, 207); margin-top: 4px;">
                    Fotografías, firmas digitales y códigos de barra por registro.
                  </div>
                </div>
              </div>
              <div
                style="display: flex; align-items: flex-start; gap: 14px; padding: 16px 0px; border-top: 1px solid rgba(255, 255, 255, 0.08); border-bottom: 1px solid rgba(255, 255, 255, 0.08);"
              >
                <i
                  class="ph ph-check-circle"
                  style="font-size: 24px; color: rgb(74, 155, 255); flex: 0 0 auto; margin-top: 2px;"></i>
                <div>
                  <div style="font-size: 1.0625rem; font-weight: 700; color: rgb(234, 240, 251);">
                    Auditoría en tiempo real
                  </div>
                  <div style="font-size: 1.0625rem; line-height: 1.6; color: rgb(147, 170, 207); margin-top: 4px;">
                    Seguimiento del personal en campo y control de calidad del dato.
                  </div>
                </div>
              </div>
            </div>
          </div>

          <!-- Columna Derecha -->
          <div style="display: flex; flex-direction: column; justify-content: center; gap: 24px;">
            <div
              style="background: rgba(255, 255, 255, 0.02); border: 1px solid rgba(255, 255, 255, 0.08); border-radius: 16px; padding: 16px; display: flex; align-items: center; justify-content: center;"
            >
              <img
                src="https://i.postimg.cc/MZfRCdsc/web-monitor-pois.png"
                alt="Dashboard de captura de POIs"
                style="width: 100%; height: auto; border-radius: 8px;"
              />
            </div>
            <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 24px;">
              <div
                style="background: rgba(255, 255, 255, 0.02); border: 1px solid rgba(255, 255, 255, 0.08); border-radius: 16px; padding: 24px; text-align: center;"
              >
                <div
                  style="font-size: clamp(2rem, 3vw, 2.5rem); font-weight: 800; line-height: 1; letter-spacing: -0.03em; color: rgb(74, 155, 255);"
                >
                  95%
                </div>
                <div style="font-size: 0.9375rem; line-height: 1.5; color: rgb(174, 195, 238); margin-top: 10px;">
                  de precisión en censos de establecimientos
                </div>
              </div>
              <div
                style="background: rgba(255, 255, 255, 0.02); border: 1px solid rgba(255, 255, 255, 0.08); border-radius: 16px; padding: 24px; text-align: center;"
              >
                <div
                  style="font-size: clamp(2rem, 3vw, 2.5rem); font-weight: 800; line-height: 1; letter-spacing: -0.03em; color: rgb(74, 155, 255);"
                >
                  120.000
                </div>
                <div style="font-size: 0.9375rem; line-height: 1.5; color: rgb(174, 195, 238); margin-top: 10px;">
                  puntos de interés en base propia
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- Niveles de Suscripción -->
    <div id="niveles" style="background: rgb(255, 255, 255); padding: 128px 0px;">
      <div style="max-width: 1280px; margin: 0px auto; padding: 0px 40px;">
        <div style="max-width: 68ch;">
          <div
            style="font-size: 0.75rem; font-weight: 700; letter-spacing: 0.14em; text-transform: uppercase; color: rgb(46, 124, 255);"
          >
            Niveles de suscripción
          </div>
          <h2
            style="margin: 14px 0px 0px; font-size: clamp(2rem, 1.2rem + 2.4vw, 3rem); line-height: 1.12; letter-spacing: -0.02em; font-weight: 800;"
          >
            Tres niveles, un mismo dato.
          </h2>
        </div>
        <div
          style="display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 20px; margin-top: 48px; align-items: start;"
        >
          <div style="border: 1px solid rgba(10, 23, 51, 0.08); border-radius: 24px; padding: 32px;">
            <div style="font-size: 19px; font-weight: 800;">Básico</div>
            <div
              style="margin-top: 14px; display: inline-block; padding: 7px 14px; border-radius: 9999px; background: rgb(242, 246, 254); color: rgb(19, 73, 216); font-size: 13px; font-weight: 700;"
            >
              A cotizar
            </div>
            <div style="font-size: 14px; color: rgb(90, 108, 140); margin-top: 10px;">alcance acotado</div>
            <div
              style="display: flex; flex-direction: column; gap: 12px; margin-top: 26px; border-top: 1px solid rgb(227, 234, 246); padding-top: 24px; font-size: 1.0625rem; line-height: 1.5; color: rgb(10, 28, 78);"
            >
              <div style="display: flex; gap: 10px;">
                <i class="ph ph-check" style="color: rgb(19, 73, 216); font-size: 18px; margin-top: 3px;"></i>Capas
                limitadas
              </div>
              <div style="display: flex; gap: 10px;">
                <i class="ph ph-check" style="color: rgb(19, 73, 216); font-size: 18px; margin-top: 3px;"></i>Acceso vía
                plataforma
              </div>
              <div style="display: flex; gap: 10px;">
                <i class="ph ph-check" style="color: rgb(19, 73, 216); font-size: 18px; margin-top: 3px;"></i>Un
                usuario
              </div>
            </div>
            <a
              href="#contacto"
              style="display: flex; align-items: center; justify-content: center; height: 48px; margin-top: 28px; border-radius: 9999px; border: 1px solid rgb(19, 73, 216); color: rgb(19, 73, 216); font-weight: 600;"
            >
              Solicita una cotización
            </a>
          </div>

          <div
            style="border: 1px solid rgb(30, 123, 255); border-radius: 24px; padding: 32px; background: rgb(247, 250, 255); box-shadow: rgba(30, 123, 255, 0.12) 0px 12px 40px; position: relative;"
          >
            <div
              style="position: absolute; top: -13px; left: 32px; padding: 5px 14px; border-radius: 9999px; background: rgb(19, 73, 216); color: rgb(255, 255, 255); font-size: 12px; font-weight: 700; letter-spacing: 0.08em;"
            >
              RECOMENDADO
            </div>
            <div style="font-size: 19px; font-weight: 800;">Pro</div>
            <div
              style="margin-top: 14px; display: inline-block; padding: 7px 14px; border-radius: 9999px; background: rgb(228, 237, 255); color: rgb(19, 73, 216); font-size: 13px; font-weight: 700;"
            >
              A cotizar
            </div>
            <div style="font-size: 14px; color: rgb(90, 108, 140); margin-top: 10px;">según capas y volumen</div>
            <div
              style="display: flex; flex-direction: column; gap: 12px; margin-top: 26px; border-top: 1px solid rgb(217, 228, 248); padding-top: 24px; font-size: 1.0625rem; line-height: 1.5; color: rgb(10, 28, 78);"
            >
              <div style="display: flex; gap: 10px;">
                <i class="ph ph-check" style="color: rgb(19, 73, 216); font-size: 18px; margin-top: 3px;"></i>Set
                completo de capas
              </div>
              <div style="display: flex; gap: 10px;">
                <i class="ph ph-check" style="color: rgb(19, 73, 216); font-size: 18px; margin-top: 3px;"></i>Módulo de
                análisis
              </div>
              <div style="display: flex; gap: 10px;">
                <i class="ph ph-check" style="color: rgb(19, 73, 216); font-size: 18px; margin-top: 3px;"></i>Acceso por
                API
              </div>
            </div>
            <a
              href="#contacto"
              style="display: flex; align-items: center; justify-content: center; height: 48px; margin-top: 28px; border-radius: 9999px; background: rgb(19, 73, 216); color: rgb(255, 255, 255); font-weight: 600;"
            >
              Solicita una muestra
            </a>
          </div>

          <div style="border: 1px solid rgba(10, 23, 51, 0.08); border-radius: 24px; padding: 32px;">
            <div style="font-size: 19px; font-weight: 800;">Enterprise</div>
            <div
              style="margin-top: 14px; display: inline-block; padding: 7px 14px; border-radius: 9999px; background: rgb(242, 246, 254); color: rgb(19, 73, 216); font-size: 13px; font-weight: 700;"
            >
              A cotizar
            </div>
            <div style="font-size: 14px; color: rgb(90, 108, 140); margin-top: 10px;">según alcance del proyecto</div>
            <div
