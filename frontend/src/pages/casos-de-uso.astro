---
import BaseLayout from '@/layouts/BaseLayout.astro';
import ContactSection from '@/components/ContactSection.astro';
---

<BaseLayout
  lang="es"
  title="smartmaps Casos de uso | Decisiones que hoy se toman con evidencia territorial"
  description="Decisiones estratégicas en Retail, Banca, Consumo Masivo y Real Estate respaldadas con evidencia geoespacial exacta."
>
  <div style="background: rgb(255, 255, 255); color: rgb(10, 28, 78); font-family: 'Plus Jakarta Sans', sans-serif;">
    <!-- Hero Section Casos de Uso -->
    <div
      style="background: radial-gradient(80% 100% at 72% 22%, rgb(18, 48, 140) 0%, rgb(10, 28, 78) 46%, rgb(5, 14, 43) 100%); color: rgb(234, 240, 251); padding: 128px 0px 144px;"
    >
      <div style="max-width: 1280px; margin: 0px auto; padding: 0px 40px;">
        <div style="max-width: 820px;">
          <h1
            style="margin: 0px; font-size: clamp(2.2rem, 1rem + 3.6vw, 4.1rem); line-height: 1.05; letter-spacing: -0.02em; font-weight: 800;"
          >
            Casos de uso
          </h1>
          <p
            style="margin: 24px 0px 0px; font-size: 1.125rem; line-height: 1.6; color: rgb(174, 195, 238); max-width: 68ch;"
          >
            Decisiones que hoy se toman con evidencia territorial.
          </p>
        </div>
      </div>
    </div>

    <!-- Contenido Casos de Uso Detalles -->
    <div style="background: rgb(255, 255, 255); padding: 112px 0px;">
      <div
        style="max-width: 1280px; margin: 0px auto; padding: 0px 40px; display: flex; flex-direction: column; gap: 40px;"
      >
        <!-- Caso 1: Retail -->
        <div
          style="border: 1px solid rgba(10, 23, 51, 0.08); border-radius: 24px; padding: 40px; display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 40px; box-shadow: rgba(6, 13, 34, 0.04) 0px 1px 2px;"
        >
          <div>
            <div style="font-size: 0.75rem; font-weight: 700; letter-spacing: 0.14em; color: rgb(46, 124, 255);">
              RETAIL
            </div>
            <div
              style="margin-top: 12px; font-size: clamp(1.375rem, 1.1rem + 1vw, 1.75rem); line-height: 1.25; font-weight: 800; letter-spacing: -0.3px;"
            >
              Expansión de puntos de venta
            </div>
            <div
              style="margin-top: 26px; font-size: clamp(2rem, 4vw, 3rem); font-weight: 800; line-height: 1; letter-spacing: -0.03em; color: rgb(19, 73, 216);"
            >
              +12% facturación por nueva sede
            </div>
            <div
              style="font-size: 0.875rem; line-height: 1.5; color: rgb(90, 108, 140); margin-top: 14px; max-width: 44ch;"
            >
              Métricas de referencia observadas en proyectos del portafolio; se validan caso a caso.
            </div>
          </div>
          <div>
            <div style="font-size: 1.0625rem; line-height: 1.6; color: rgb(10, 28, 78); max-width: 68ch;">
              Abrir sin evidencia cuesta ventas y arriendos mal pagados. Con atractividad comercial y movilidad, la sede se
              elige por potencial medido.
            </div>
            <div
              style="font-size: 0.75rem; font-weight: 700; letter-spacing: 0.14em; text-transform: uppercase; color: rgb(90, 108, 140); margin-top: 30px;"
            >
              Capas que alimentan la decisión
            </div>
            <div style="display: flex; flex-wrap: wrap; gap: 9px; margin-top: 14px;">
              <a
                href="/data#capas"
                style="padding: 9px 16px; border-radius: 9999px; background: rgb(242, 246, 254); border: 1px solid rgba(30, 123, 255, 0.2); font-size: 13.5px; font-weight: 600; color: rgb(19, 73, 216);"
              >
                Atractividad comercial
              </a>
              <a
                href="/data#capas"
                style="padding: 9px 16px; border-radius: 9999px; background: rgb(242, 246, 254); border: 1px solid rgba(30, 123, 255, 0.2); font-size: 13.5px; font-weight: 600; color: rgb(19, 73, 216);"
              >
                Movilidad
              </a>
              <a
                href="/data#capas"
                style="padding: 9px 16px; border-radius: 9999px; background: rgb(242, 246, 254); border: 1px solid rgba(30, 123, 255, 0.2); font-size: 13.5px; font-weight: 600; color: rgb(19, 73, 216);"
              >
                Tejido empresarial
              </a>
              <a
                href="/data#capas"
                style="padding: 9px 16px; border-radius: 9999px; background: rgb(242, 246, 254); border: 1px solid rgba(30, 123, 255, 0.2); font-size: 13.5px; font-weight: 600; color: rgb(19, 73, 216);"
              >
                Sociodemografía
              </a>
            </div>
            <a
              href="#contacto"
              style="display: inline-flex; align-items: center; gap: 9px; height: 48px; padding: 0px 24px; margin-top: 32px; border-radius: 9999px; border: 1px solid rgb(19, 73, 216); color: rgb(19, 73, 216); font-weight: 600; transition: opacity 0.2s;"
            >
              Habla con un experto <i class="ph ph-arrow-right" style="font-size: 15px;"></i>
            </a>
          </div>
        </div>

        <!-- Caso 2: Banca y Seguros -->
        <div
          style="border: 1px solid rgba(10, 23, 51, 0.08); border-radius: 24px; padding: 40px; display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 40px; box-shadow: rgba(6, 13, 34, 0.04) 0px 1px 2px;"
        >
          <div>
            <div style="font-size: 0.75rem; font-weight: 700; letter-spacing: 0.14em; color: rgb(46, 124, 255);">
              BANCA Y SEGUROS
            </div>
            <div
              style="margin-top: 12px; font-size: clamp(1.375rem, 1.1rem + 1vw, 1.75rem); line-height: 1.25; font-weight: 800; letter-spacing: -0.3px;"
            >
              Scoring con contexto territorial
            </div>
            <div
              style="margin-top: 26px; font-size: clamp(2rem, 4vw, 3rem); font-weight: 800; line-height: 1; letter-spacing: -0.03em; color: rgb(19, 73, 216);"
            >
              95% precisión en censos
            </div>
            <div
              style="font-size: 0.875rem; line-height: 1.5; color: rgb(90, 108, 140); margin-top: 14px; max-width: 44ch;"
            >
              Métricas de referencia observadas en proyectos del portafolio; se validan caso a caso.
            </div>
          </div>
          <div>
            <div style="font-size: 1.0625rem; line-height: 1.6; color: rgb(10, 28, 78); max-width: 68ch;">
              El domicilio dice más que el formulario: entorno, ingreso y tejido empresarial alimentan los modelos de
              riesgo.
            </div>
            <div
              style="font-size: 0.75rem; font-weight: 700; letter-spacing: 0.14em; text-transform: uppercase; color: rgb(90, 108, 140); margin-top: 30px;"
            >
              Capas que alimentan la decisión
            </div>
            <div style="display: flex; flex-wrap: wrap; gap: 9px; margin-top: 14px;">
              <a
                href="/data#capas"
                style="padding: 9px 16px; border-radius: 9999px; background: rgb(242, 246, 254); border: 1px solid rgba(30, 123, 255, 0.2); font-size: 13.5px; font-weight: 600; color: rgb(19, 73, 216);"
              >
                Entorno / Real Estate
              </a>
              <a
                href="/data#capas"
                style="padding: 9px 16px; border-radius: 9999px; background: rgb(242, 246, 254); border: 1px solid rgba(30, 123, 255, 0.2); font-size: 13.5px; font-weight: 600; color: rgb(19, 73, 216);"
              >
                Sociodemografía
              </a>
              <a
                href="/data#capas"
                style="padding: 9px 16px; border-radius: 9999px; background: rgb(242, 246, 254); border: 1px solid rgba(30, 123, 255, 0.2); font-size: 13.5px; font-weight: 600; color: rgb(19, 73, 216);"
              >
                Tejido empresarial
              </a>
            </div>
            <a
              href="#contacto"
              style="display: inline-flex; align-items: center; gap: 9px; height: 48px; padding: 0px 24px; margin-top: 32px; border-radius: 9999px; border: 1px solid rgb(19, 73, 216); color: rgb(19, 73, 216); font-weight: 600; transition: opacity 0.2s;"
            >
              Habla con un experto <i class="ph ph-arrow-right" style="font-size: 15px;"></i>
            </a>
          </div>
        </div>

        <!-- Caso 3: Consumo Masivo -->
        <div
          style="border: 1px solid rgba(10, 23, 51, 0.08); border-radius: 24px; padding: 40px; display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 40px; box-shadow: rgba(6, 13, 34, 0.04) 0px 1px 2px;"
        >
          <div>
            <div style="font-size: 0.75rem; font-weight: 700; letter-spacing: 0.14em; color: rgb(46, 124, 255);">
              CONSUMO MASIVO
            </div>
            <div
              style="margin-top: 12px; font-size: clamp(1.375rem, 1.1rem + 1vw, 1.75rem); line-height: 1.25; font-weight: 800; letter-spacing: -0.3px;"
            >
              Cobertura de distribución
            </div>
            <div
              style="margin-top: 26px; font-size: clamp(2rem, 4vw, 3rem); font-weight: 800; line-height: 1; letter-spacing: -0.03em; color: rgb(19, 73, 216);"
            >
              +24% margen en distribución
            </div>
            <div
              style="font-size: 0.875rem; line-height: 1.5; color: rgb(90, 108, 140); margin-top: 14px; max-width: 44ch;"
            >
              Métricas de referencia observadas en proyectos del portafolio; se validan caso a caso.
            </div>
          </div>
          <div>
            <div style="font-size: 1.0625rem; line-height: 1.6; color: rgb(10, 28, 78); max-width: 68ch;">
              Las rutas heredadas dejan zonas sin cubrir. El territorio se reparte según densidad de negocio y demanda
              real.
            </div>
            <div
              style="font-size: 0.75rem; font-weight: 700; letter-spacing: 0.14em; text-transform: uppercase; color: rgb(90, 108, 140); margin-top: 30px;"
            >
              Capas que alimentan la decisión
            </div>
            <div style="display: flex; flex-wrap: wrap; gap: 9px; margin-top: 14px;">
              <a
                href="/data#capas"
                style="padding: 9px 16px; border-radius: 9999px; background: rgb(242, 246, 254); border: 1px solid rgba(30, 123, 255, 0.2); font-size: 13.5px; font-weight: 600; color: rgb(19, 73, 216);"
              >
                Tejido empresarial
              </a>
              <a
                href="/data#capas"
                style="padding: 9px 16px; border-radius: 9999px; background: rgb(242, 246, 254); border: 1px solid rgba(30, 123, 255, 0.2); font-size: 13.5px; font-weight: 600; color: rgb(19, 73, 216);"
              >
                Sociodemografía
              </a>
              <a
                href="/data#capas"
                style="padding: 9px 16px; border-radius: 9999px; background: rgb(242, 246, 254); border: 1px solid rgba(30, 123, 255, 0.2); font-size: 13.5px; font-weight: 600; color: rgb(19, 73, 216);"
              >
                POIs
              </a>
            </div>
            <a
              href="#contacto"
              style="display: inline-flex; align-items: center; gap: 9px; height: 48px; padding: 0px 24px; margin-top: 32px; border-radius: 9999px; border: 1px solid rgb(19, 73, 216); color: rgb(19, 73, 216); font-weight: 600; transition: opacity 0.2s;"
            >
              Habla con un experto <i class="ph ph-arrow-right" style="font-size: 15px;"></i>
            </a>
          </div>
        </div>

        <!-- Caso 4: Real Estate y OOH -->
        <div
          style="border: 1px solid rgba(10, 23, 51, 0.08); border-radius: 24px; padding: 40px; display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 40px; box-shadow: rgba(6, 13, 34, 0.04) 0px 1px 2px;"
        >
          <div>
            <div style="font-size: 0.75rem; font-weight: 700; letter-spacing: 0.14em; color: rgb(46, 124, 255);">
              REAL ESTATE Y OOH
            </div>
            <div
              style="margin-top: 12px; font-size: clamp(1.375rem, 1.1rem + 1vw, 1.75rem); line-height: 1.25; font-weight: 800; letter-spacing: -0.3px;"
            >
              Valuación y exposición
            </div>
            <div
              style="margin-top: 26px; font-size: clamp(2rem, 4vw, 3rem); font-weight: 800; line-height: 1; letter-spacing: -0.03em; color: rgb(19, 73, 216);"
            >
              +32% VAC en publicidad exterior
            </div>
            <div
              style="font-size: 0.875rem; line-height: 1.5; color: rgb(90, 108, 140); margin-top: 14px; max-width: 44ch;"
            >
              Métricas de referencia observadas en proyectos del portafolio; se validan caso a caso.
            </div>
          </div>
          <div>
            <div style="font-size: 1.0625rem; line-height: 1.6; color: rgb(10, 28, 78); max-width: 68ch;">
              El valor depende de quién pasa por ahí. Movilidad y entorno lo convierten en un número defendible.
            </div>
            <div
              style="font-size: 0.75rem; font-weight: 700; letter-spacing: 0.14em; text-transform: uppercase; color: rgb(90, 108, 140); margin-top: 30px;"
            >
              Capas que alimentan la decisión
            </div>
            <div style="display: flex; flex-wrap: wrap; gap: 9px; margin-top: 14px;">
              <a
                href="/data#capas"
                style="padding: 9px 16px; border-radius: 9999px; background: rgb(242, 246, 254); border: 1px solid rgba(30, 123, 255, 0.2); font-size: 13.5px; font-weight: 600; color: rgb(19, 73, 216);"
              >
                Movilidad
              </a>
              <a
                href="/data#capas"
                style="padding: 9px 16px; border-radius: 9999px; background: rgb(242, 246, 254); border: 1px solid rgba(30, 123, 255, 0.2); font-size: 13.5px; font-weight: 600; color: rgb(19, 73, 216);"
              >
                Entorno / Real Estate
              </a>
              <a
                href="/data#capas"
                style="padding: 9px 16px; border-radius: 9999px; background: rgb(242, 246, 254); border: 1px solid rgba(30, 123, 255, 0.2); font-size: 13.5px; font-weight: 600; color: rgb(19, 73, 216);"
              >
                Turismo
              </a>
            </div>
            <a
              href="#contacto"
              style="display: inline-flex; align-items: center; gap: 9px; height: 48px; padding: 0px 24px; margin-top: 32px; border-radius: 9999px; border: 1px solid rgb(19, 73, 216); color: rgb(19, 73, 216); font-weight: 600; transition: opacity 0.2s;"
            >
              Habla con un experto <i class="ph ph-arrow-right" style="font-size: 15px;"></i>
            </a>
          </div>
        </div>
      </div>
    </div>

    <!-- Formulario de Contacto en dos columnas -->
    <ContactSection
      lang="es"
      title="Cuéntanos tu reto de negocio."
      subtitle="No vendemos herramientas genéricas. Entendemos tu industria, analizamos qué capas y modelos aportan valor, y diseñamos una solución rentable para tu operación."
      secondaryCtaText="info@intelligisgroup.com"
      secondaryCtaHref="mailto:info@intelligisgroup.com"
      submitButtonText="Enviar solicitud"
    />
  </div>
</BaseLayout>
