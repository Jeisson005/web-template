---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { getPages } from '@/lib/payload';
import { CMS_ADMIN_URL, CMS_PAGES_ADMIN_URL } from '@/lib/config';

let cmsPages = [];
try {
  cmsPages = await getPages();
} catch (e) {
  cmsPages = [];
}
---

<BaseLayout
  title="Web Template"
  description="Minimal, high-performance static website template powered by Astro and Payload CMS."
>
  <!-- Minimalist Hero -->
  <section class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 pt-20 pb-16 text-center">
    <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-emerald-500/10 border border-emerald-500/20 text-emerald-400 text-xs font-semibold uppercase tracking-wider mb-6">
      <span class="w-2 h-2 rounded-full bg-emerald-400"></span>
      Ready Base Template
    </div>

    <h1 class="text-4xl sm:text-5xl font-extrabold text-white tracking-tight leading-tight">
      Your next website starts here
    </h1>

    <p class="mt-4 text-base sm:text-lg text-zinc-400 max-w-xl mx-auto leading-relaxed">
      A lightweight boilerplate built with pure static generation, decoupled visual content management, and multi-database support.
    </p>

    <div class="mt-8 flex flex-wrap items-center justify-center gap-3">
      <a
        href={CMS_ADMIN_URL}
        target="_blank"
        rel="noopener noreferrer"
        class="px-5 py-2.5 rounded-xl bg-emerald-500 hover:bg-emerald-400 text-zinc-950 font-bold text-sm shadow-md shadow-emerald-500/20 transition-colors inline-flex items-center gap-2"
      >
        <span>Manage Content</span>
        <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
        </svg>
      </a>

      <a
        href="/contact"
        class="px-5 py-2.5 rounded-xl bg-zinc-900 hover:bg-zinc-800 text-zinc-300 border border-zinc-700/80 font-medium text-sm transition-colors"
      >
        Contact Form
      </a>
    </div>
  </section>

  <!-- Dynamic Pages Published from CMS -->
  <section class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-10">
    <div class="glass-panel p-6 sm:p-8 rounded-2xl border border-zinc-800">
      <div class="flex items-center justify-between pb-4 border-b border-zinc-800">
        <h2 class="text-base font-bold text-white">Pages in CMS</h2>
        <a
          href={CMS_PAGES_ADMIN_URL}
          target="_blank"
          rel="noopener noreferrer"
          class="text-xs text-emerald-400 hover:text-emerald-300 font-medium"
        >
          + New Page
        </a>
      </div>

      {cmsPages.length > 0 ? (
        <div class="mt-4 grid grid-cols-1 sm:grid-cols-2 gap-3">
          {cmsPages.map((page) => (
            <a
              href={`/${page.slug}`}
              class="p-4 rounded-xl bg-zinc-900/60 border border-zinc-800 hover:border-emerald-500/40 transition-colors group block"
            >
              <h3 class="font-semibold text-white group-hover:text-emerald-400 transition-colors text-sm flex items-center justify-between">
                <span>{page.title}</span>
                <span class="text-xs font-mono text-zinc-500">/{page.slug}</span>
              </h3>
              {page.hero?.subheading && (
                <p class="text-xs text-zinc-400 mt-1 line-clamp-1">{page.hero.subheading}</p>
              )}
            </a>
          ))}
        </div>
      ) : (
        <div class="mt-6 py-6 text-center">
          <p class="text-sm text-zinc-400">No pages published yet in the CMS.</p>
          <p class="text-xs text-zinc-500 mt-1">
            Log in at <a href={CMS_ADMIN_URL} target="_blank" class="text-emerald-400 underline underline-offset-2">localhost:3000/admin</a> to publish your first page.
          </p>
        </div>
      )}
    </div>
  </section>
</BaseLayout>
