---
import BaseLayout from '@/layouts/BaseLayout.astro';
import IndustryCarousel from '@/components/IndustryCarousel.astro';
import FadeCarousel from '@/components/FadeCarousel.astro';
import ContactSection from '@/components/ContactSection.astro';
---

<BaseLayout
  lang="es"
  title="smartmaps | Inteligencia geoespacial para decisiones de negocios"
  description="Datos territoriales listos para consumir y soluciones GIS a la medida. Intelligis Technologies, partner oficial Esri."
>
  <div style="background: rgb(255, 255, 255); color: rgb(10, 28, 78); font-family: 'Plus Jakarta Sans', sans-serif;">
    <!-- Hero Section -->
    <div
      style="position: relative; overflow: hidden; background: radial-gradient(80% 100% at 72% 22%, rgb(18, 48, 140) 0%, rgb(10, 28, 78) 46%, rgb(5, 14, 43) 100%); color: rgb(234, 240, 251); padding: 112px 0px 128px;"
    >
      <div
        aria-hidden="true"
        style="position: absolute; inset: 0px; display: grid; grid-template-columns: repeat(30, 1fr); gap: 2px; mask-image: radial-gradient(60% 80% at 78% 34%, rgb(0, 0, 0) 0%, transparent 74%); pointer-events: none;"
        id="sm-hero-grid"
      >
      </div>
      <div
        style="position: relative; z-index: 2; max-width: 1280px; margin: 0px auto; padding: 0px 40px; display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 48px;"
      >
        <div style="flex: 1 1 480px; max-width: 640px;">
          <h1
            style="margin: 0px; font-size: clamp(2.2rem, 1rem + 3.6vw, 4.1rem); line-height: 1.1; letter-spacing: -0.02em; font-weight: 800;"
          >
            Inteligencia geoespacial<br />
            para <span style="color: rgb(255, 255, 255);">decisiones de negocios</span>
          </h1>
          <p
            style="margin: 24px 0px 0px; font-size: 1.125rem; line-height: 1.6; color: rgb(174, 195, 238); max-width: 68ch;"
          >
            Datos territoriales listos para consumir y soluciones GIS a la medida.
          </p>
          <div style="display: flex; flex-wrap: wrap; gap: 14px; margin-top: 36px;">
            <a
              href="#contacto"
              style="display: inline-flex; align-items: center; height: 48px; padding: 0px 24px; border-radius: 9999px; background: rgb(30, 123, 255); color: rgb(255, 255, 255); font-weight: 600;"
            >
              Solicita una muestra de datos
            </a>
            <a
              href="#contacto"
              style="display: inline-flex; align-items: center; height: 48px; padding: 0px 24px; border-radius: 9999px; border: 1px solid rgba(111, 178, 255, 0.5); color: rgb(234, 240, 251); font-weight: 600;"
            >
              Habla con un experto
            </a>
          </div>

          <!-- Sección Clientes (Hero) -->
          <div style="margin-top: 56px;">
            <p style="font-size: 1.125rem; line-height: 1.6; color: rgb(174, 195, 238); margin-bottom: 24px;">
              Ellos y muchos más ya utilizan Smartmaps...
            </p>
            <div
              style="display: flex; flex-wrap: nowrap; align-items: center; justify-content: space-between; gap: 20px; opacity: 0.85; width: 100%;"
            >
              <img
                src="https://i.postimg.cc/y8cKxmsg/Canal-de-Panama-logo-blanco-transparente.png"
                alt="Canal de Panama"
                style="height: 42px; width: auto; object-fit: contain; flex-shrink: 0;"
              />
              <img
                src="https://i.postimg.cc/Z5pmn84n/Colgas-logo-blanco-transparente.png"
                alt="Colgas"
                style="height: 54px; width: auto; object-fit: contain; flex-shrink: 0;"
              />
              <img
                src="https://i.postimg.cc/DwLh0rn8/FEMSA-logo-blanco-transparente.png"
                alt="FEMSA"
                style="height: 54px; width: auto; object-fit: contain; flex-shrink: 0;"
              />
              <img
                src="https://i.postimg.cc/t4WbJ3pC/Heineken-logo-blanco-transparente.png"
                alt="Heineken"
                style="height: 34px; width: auto; object-fit: contain; flex-shrink: 0;"
              />
              <img
                src="https://i.postimg.cc/3xmhNXYR/Herbalife-logo-blanco-transparente.png"
                alt="Herbalife"
                style="height: 34px; width: auto; object-fit: contain; flex-shrink: 0;"
              />
            </div>
          </div>
        </div>

        <!-- Imagen del Hero movida hacia arriba (-100px) -->
        <div style="flex: 1 1 400px; display: flex; justify-content: center; align-items: flex-start;">
          <img
            src="https://i.postimg.cc/0jGrB4xv/imagen-3-hero-smartmaps.png"
            alt="Dashboard plataforma Smartmaps"
            style="width: 100%; max-width: 580px; height: auto; display: block; object-fit: contain; filter: drop-shadow(0 20px 40px rgba(0,0,0,0.2)); margin-top: -100px;"
          />
        </div>
      </div>
    </div>

    <!-- SECCIÓN VERTICALES -->
    <div style="background: rgb(255, 255, 255); padding: 128px 0px 48px;">
      <div style="max-width: 1280px; margin: 0px auto; padding: 0px 40px;">
        <div style="max-width: 68ch;">
          <div
            style="font-size: 0.75rem; font-weight: 700; letter-spacing: 0.14em; text-transform: uppercase; color: rgb(46, 124, 255);"
          >
            Verticales
          </div>
          <h2
            style="margin: 14px 0px 0px; font-size: clamp(2rem, 1.2rem + 2.4vw, 3rem); line-height: 1.12; letter-spacing: -0.02em; font-weight: 800;"
          >
            Tres formas de trabajar con nosotros.
          </h2>
          <p style="margin: 18px 0px 0px; font-size: 1.125rem; line-height: 1.6; color: rgb(90, 108, 140);">
            Datos listos para consumir, capacidad certificada sobre la plataforma que el cliente ya tiene, y desarrollo
            propio cuando el dato o la aplicación no existen.
          </p>
        </div>
        <div
          style="display: grid; grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); gap: 20px; margin-top: 56px;"
        >
          <a
            href="/data"
            style="display: flex; flex-direction: column; border: 1px solid rgba(10, 23, 51, 0.08); border-radius: 16px; padding: 30px; color: rgb(10, 28, 78); box-shadow: rgba(6, 13, 34, 0.04) 0px 1px 2px; transition: transform 0.2s, border-color 0.2s;"
          >
            <div
              style="font-size: 22px; font-weight: 800; letter-spacing: -0.4px; display: flex; flex-direction: column; align-items: flex-start; gap: 12px;"
            >
              <img
                src="https://i.postimg.cc/SQ8pgYc1/logo-SM-claro-transparente.png"
                alt="smartmaps"
                style="height: 60px; width: auto; display: block;"
              />
              <span>Data</span>
            </div>
            <div style="font-size: 1.0625rem; line-height: 1.6; color: rgb(90, 108, 140); margin-top: 10px; flex: 1 1 0%;">
              Capas de datos georreferenciados listos para consumir.
            </div>
            <div style="margin-top: 20px; font-size: 15px; font-weight: 700; color: rgb(19, 73, 216);">
              Ver vertical →
            </div>
          </a>
          <a
            href="/professional-services"
            style="display: flex; flex-direction: column; border: 1px solid rgba(10, 23, 51, 0.08); border-radius: 16px; padding: 30px; color: rgb(10, 28, 78); box-shadow: rgba(6, 13, 34, 0.04) 0px 1px 2px; transition: transform 0.2s, border-color 0.2s;"
          >
            <div
              style="font-size: 22px; font-weight: 800; letter-spacing: -0.4px; display: flex; flex-direction: column; align-items: flex-start; gap: 12px;"
            >
              <img
                src="https://i.postimg.cc/SQ8pgYc1/logo-SM-claro-transparente.png"
                alt="smartmaps"
                style="height: 60px; width: auto; display: block;"
              />
              <span>Servicios Profesionales</span>
            </div>
            <div style="font-size: 1.0625rem; line-height: 1.6; color: rgb(90, 108, 140); margin-top: 10px; flex: 1 1 0%;">
              Implementación e integración GIS sobre el licenciamiento Esri del propio cliente.
            </div>
            <div style="margin-top: 20px; font-size: 15px; font-weight: 700; color: rgb(19, 73, 216);">
              Ver vertical →
            </div>
          </a>
          <a
            href="/soluciones-a-la-medida"
            style="display: flex; flex-direction: column; border: 1px solid rgba(10, 23, 51, 0.08); border-radius: 16px; padding: 30px; color: rgb(10, 28, 78); box-shadow: rgba(6, 13, 34, 0.04) 0px 1px 2px; transition: transform 0.2s, border-color 0.2s;"
          >
            <div
              style="font-size: 22px; font-weight: 800; letter-spacing: -0.4px; display: flex; flex-direction: column; align-items: flex-start; gap: 12px;"
            >
              <img
                src="https://i.postimg.cc/SQ8pgYc1/logo-SM-claro-transparente.png"
                alt="smartmaps"
                style="height: 60px; width: auto; display: block;"
              />
              <span>Soluciones a la medida</span>
            </div>
            <div style="font-size: 1.0625rem; line-height: 1.6; color: rgb(90, 108, 140); margin-top: 10px; flex: 1 1 0%;">
              Levantamiento en campo (censos, encuestas, POIs) más desarrollo GIS propio.
            </div>
            <div style="margin-top: 20px; font-size: 15px; font-weight: 700; color: rgb(11, 110, 150);">
              Ver vertical →
            </div>
          </a>
        </div>
      </div>
    </div>

    <!-- SECCIÓN A QUIÉN VA DIRIGIDO -->
    <div style="background: rgb(255, 255, 255); padding: 48px 0px 128px;">
      <div style="max-width: 1280px; margin: 0px auto; padding: 0px 40px;">
        <div
          style="display: grid; grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); gap: 48px; align-items: center;"
        >
          <div style="max-width: 68ch;">
            <h2
              style="margin: 0px; font-size: clamp(2rem, 1.2rem + 2.4vw, 3rem); line-height: 1.12; letter-spacing: -0.02em; font-weight: 800;"
            >
              A quién va dirigido?
            </h2>
            <p style="margin: 18px 0px 0px; font-size: 1.125rem; line-height: 1.6; color: rgb(90, 108, 140);">
              Para organizaciones que necesitan convertir la ubicación, el mercado y el comportamiento de sus clientes en
              una ventaja competitiva.
            </p>
          </div>
          <img
            src="https://i.postimg.cc/WzZk01Fj/web-api-laptop.png"
            alt="Plataforma de location intelligence"
            style="width: 100%; height: auto; display: block;"
          />
        </div>

        <IndustryCarousel lang="es" theme="dark" id="sm" />
      </div>
    </div>

    <!-- SECCIÓN CASOS DE USO -->
    <div style="background: rgb(255, 255, 255); padding: 128px 0px;">
      <div style="max-width: 1280px; margin: 0px auto; padding: 0px 40px;">
        <div style="max-width: 68ch;">
          <div
            style="font-size: 0.75rem; font-weight: 700; letter-spacing: 0.14em; text-transform: uppercase; color: rgb(46, 124, 255);"
          >
            Casos de uso
          </div>
          <h2
            style="margin: 14px 0px 0px; font-size: clamp(2rem, 1.2rem + 2.4vw, 3rem); line-height: 1.12; letter-spacing: -0.02em; font-weight: 800;"
          >
            Inteligencia espacial para decisiones rentables.
          </h2>
          <p style="margin: 18px 0px 0px; font-size: 1.125rem; line-height: 1.6; color: rgb(90, 108, 140);">
            Decisiones estratégicas que hoy puedes respaldar con evidencia geoespacial exacta.
          </p>
        </div>
        <div
          style="display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 20px; margin-top: 56px;"
        >
          <a
            href="/casos-de-uso"
            style="display: flex; flex-direction: column; background: rgb(10, 23, 51); border: 1px solid rgba(255, 255, 255, 0.08); border-radius: 16px; padding: 28px; color: rgb(234, 240, 251); transition: transform 0.2s, border-color 0.2s; text-align: center; align-items: center;"
          >
            <div style="font-size: 0.75rem; font-weight: 700; letter-spacing: 0.14em; color: rgb(74, 155, 255);">
              RETAIL
            </div>
            <div style="font-size: 19px; font-weight: 800; margin-top: 10px; letter-spacing: -0.3px;">
              Expansión de puntos de venta
            </div>
            <div
              style="font-size: 1.0625rem; line-height: 1.6; color: rgb(174, 195, 238); margin-top: 12px; flex: 1 1 0%;"
            >
              Abrir sin evidencia cuesta ventas y arriendos mal pagados. Con atractividad comercial y movilidad, la sede se
              elige por potencial medido.
            </div>
            <div
              style="font-size: 20px; font-weight: 800; letter-spacing: -0.5px; color: rgb(255, 255, 255); margin-top: 22px; width: 100%; padding-top: 16px;"
            >
              +12% facturación por nueva sede
            </div>
          </a>
          <a
            href="/casos-de-uso"
            style="display: flex; flex-direction: column; background: rgb(10, 23, 51); border: 1px solid rgba(255, 255, 255, 0.08); border-radius: 16px; padding: 28px; color: rgb(234, 240, 251); transition: transform 0.2s, border-color 0.2s; text-align: center; align-items: center;"
          >
            <div style="font-size: 0.75rem; font-weight: 700; letter-spacing: 0.14em; color: rgb(74, 155, 255);">
              BANCA Y SEGUROS
            </div>
            <div style="font-size: 19px; font-weight: 800; margin-top: 10px; letter-spacing: -0.3px;">
              Scoring con contexto territorial
            </div>
            <div
              style="font-size: 1.0625rem; line-height: 1.6; color: rgb(174, 195, 238); margin-top: 12px; flex: 1 1 0%;"
            >
              El domicilio dice más que el formulario: entorno, ingreso y tejido empresarial alimentan los modelos de
              riesgo.
            </div>
            <div
              style="font-size: 20px; font-weight: 800; letter-spacing: -0.5px; color: rgb(255, 255, 255); margin-top: 22px; width: 100%; padding-top: 16px;"
            >
              95% precisión en censos
            </div>
          </a>
          <a
            href="/casos-de-uso"
            style="display: flex; flex-direction: column; background: rgb(10, 23, 51); border: 1px solid rgba(255, 255, 255, 0.08); border-radius: 16px; padding: 28px; color: rgb(234, 240, 251); transition: transform 0.2s, border-color 0.2s; text-align: center; align-items: center;"
          >
            <div style="font-size: 0.75rem; font-weight: 700; letter-spacing: 0.14em; color: rgb(74, 155, 255);">
              CONSUMO MASIVO
            </div>
            <div style="font-size: 19px; font-weight: 800; margin-top: 10px; letter-spacing: -0.3px;">
              Cobertura de distribución
            </div>
            <div
              style="font-size: 1.0625rem; line-height: 1.6; color: rgb(174, 195, 238); margin-top: 12px; flex: 1 1 0%;"
            >
              Las rutas heredadas dejan zonas sin cubrir. El territorio se reparte según densidad de negocio y demanda
              real.
            </div>
            <div
              style="font-size: 20px; font-weight: 800; letter-spacing: -0.5px; color: rgb(255, 255, 255); margin-top: 22px; width: 100%; padding-top: 16px;"
            >
              +24% margen en distribución
            </div>
          </a>
          <a
            href="/casos-de-uso"
            style="display: flex; flex-direction: column; background: rgb(10, 23, 51); border: 1px solid rgba(255, 255, 255, 0.08); border-radius: 16px; padding: 28px; color: rgb(234, 240, 251); transition: transform 0.2s, border-color 0.2s; text-align: center; align-items: center;"
          >
            <div style="font-size: 0.75rem; font-weight: 700; letter-spacing: 0.14em; color: rgb(74, 155, 255);">
              REAL ESTATE Y OOH
            </div>
            <div style="font-size: 19px; font-weight: 800; margin-top: 10px; letter-spacing: -0.3px;">
              Valuación y<br />exposición
            </div>
            <div
              style="font-size: 1.0625rem; line-height: 1.6; color: rgb(174, 195, 238); margin-top: 12px; flex: 1 1 0%;"
            >
              El valor depende de quién pasa por ahí. Movilidad y entorno lo convierten en un número defendible.
            </div>
            <div
              style="font-size: 20px; font-weight: 800; letter-spacing: -0.5px; color: rgb(255, 255, 255); margin-top: 22px; width: 100%; padding-top: 16px;"
            >
              +32% VAC en publicidad exterior
            </div>
          </a>
        </div>
        <div
          style="font-size: 0.875rem; line-height: 1.5; color: rgb(147, 170, 207); margin-top: 22px; max-width: 68ch;"
        >
          Métricas de referencia observadas en proyectos del portafolio; se validan caso a caso.
        </div>
        <a
          href="/casos-de-uso"
          style="display: inline-flex; align-items: center; gap: 9px; height: 48px; padding: 0px 24px; margin-top: 28px; border-radius: 9999px; border: 1px solid rgba(111, 178, 255, 0.5); color: rgb(10, 28, 78); font-weight: 600;"
        >
          Ver casos de uso <i class="ph ph-arrow-right" style="font-size: 15px;"></i>
        </a>
      </div>
    </div>

    <!-- SECCIÓN CAPAS DE DATOS -->
    <div style="background: rgb(5, 14, 43); color: rgb(234, 240, 251); padding: 128px 0px;">
      <div style="max-width: 1280px; margin: 0px auto; padding: 0px 40px;">
        <div
          style="display: grid; grid-template-columns: repeat(auto-fit, minmax(320px, 1fr)); gap: 64px; align-items: center;"
        >
          <div>
            <div
              style="font-size: 0.75rem; font-weight: 700; letter-spacing: 0.14em; text-transform: uppercase; color: rgb(74, 155, 255);"
            >
              Capas de datos
            </div>
            <h2
              style="margin: 14px 0px 0px; font-size: clamp(2rem, 1.2rem + 2.4vw, 3rem); line-height: 1.12; letter-spacing: -0.02em; font-weight: 800; color: rgb(255, 255, 255);"
            >
              Todo el territorio, en múltiples capas:
            </h2>
            <p style="margin: 18px 0px 0px; font-size: 1.125rem; line-height: 1.6; color: rgb(174, 195, 238);">
              Microdatos de mercado con cobertura urbana, agregados a celda de 100 metros. Se consumen completos o por
              capa.
            </p>

            <div style="margin-top: 36px; display: flex; flex-direction: column;">
              <div
                style="display: flex; align-items: flex-start; gap: 14px; padding: 14px 0px; border-bottom: 1px solid rgba(255, 255, 255, 0.08);"
              >
                <i class="ph ph-users" style="font-size: 22px; color: rgb(74, 155, 255); margin-top: 2px;"></i>
                <div style="font-size: 15px; line-height: 1.5;">
                  <span style="font-weight: 700; color: rgb(234, 240, 251); display: inline-block; margin-right: 8px;">Sociodemografía</span>{' '}
                  <span style="color: rgb(147, 170, 207);">Población, hogares, ingreso y consumo por celda.</span>
                </div>
              </div>
              <div
                style="display: flex; align-items: flex-start; gap: 14px; padding: 14px 0px; border-bottom: 1px solid rgba(255, 255, 255, 0.08);"
              >
                <i
                  class="ph ph-person-simple-walk"
                  style="font-size: 22px; color: rgb(74, 155, 255); margin-top: 2px;"
                ></i>
                <div style="font-size: 15px; line-height: 1.5;">
                  <span style="font-weight: 700; color: rgb(234, 240, 251); display: inline-block; margin-right: 8px;">Movilidad</span>{' '}
                  <span style="color: rgb(147, 170, 207);">Flujos de transeúntes y patrones de desplazamiento.</span>
                </div>
              </div>
              <div
                style="display: flex; align-items: flex-start; gap: 14px; padding: 14px 0px; border-bottom: 1px solid rgba(255, 255, 255, 0.08);"
              >
                <i class="ph ph-map-pin" style="font-size: 22px; color: rgb(74, 155, 255); margin-top: 2px;"></i>
                <div style="font-size: 15px; line-height: 1.5;">
                  <span style="font-weight: 700; color: rgb(234, 240, 251); display: inline-block; margin-right: 8px;">POIs</span>{' '}
                  <span style="color: rgb(147, 170, 207);">Puntos de interés censados y clasificados.</span>
                </div>
              </div>
              <div
                style="display: flex; align-items: flex-start; gap: 14px; padding: 14px 0px; border-bottom: 1px solid rgba(255, 255, 255, 0.08);"
              >
                <i class="ph ph-airplane-tilt" style="font-size: 22px; color: rgb(74, 155, 255); margin-top: 2px;"></i>
                <div style="font-size: 15px; line-height: 1.5;">
                  <span style="font-weight: 700; color: rgb(234, 240, 251); display: inline-block; margin-right: 8px;">Turismo</span>{' '}
                  <span style="color: rgb(147, 170, 207);">Visitantes, estacionalidad y oferta turística.</span>
                </div>
              </div>
              <div
                style="display: flex; align-items: flex-start; gap: 14px; padding: 14px 0px; border-bottom: 1px solid rgba(255, 255, 255, 0.08);"
              >
                <i class="ph ph-storefront" style="font-size: 22px; color: rgb(74, 155, 255); margin-top: 2px;"></i>
                <div style="font-size: 15px; line-height: 1.5;">
                  <span style="font-weight: 700; color: rgb(234, 240, 251); display: inline-block; margin-right: 8px;">Atractividad comercial</span>{' '}
                  <span style="color: rgb(147, 170, 207);">Índice de potencial por celda de 100 m.</span>
                </div>
              </div>
              <div
                style="display: flex; align-items: flex-start; gap: 14px; padding: 14px 0px; border-bottom: 1px solid rgba(255, 255, 255, 0.08);"
              >
                <i class="ph ph-buildings" style="font-size: 22px; color: rgb(74, 155, 255); margin-top: 2px;"></i>
                <div style="font-size: 15px; line-height: 1.5;">
                  <span style="font-weight: 700; color: rgb(234, 240, 251); display: inline-block; margin-right: 8px;">Entorno / Real Estate</span>{' '}
                  <span style="color: rgb(147, 170, 207);">Uso de suelo, precios y entorno construido.</span>
                </div>
              </div>
              <div
                style="display: flex; align-items: flex-start; gap: 14px; padding: 14px 0px; border-bottom: 1px solid rgba(255, 255, 255, 0.08);"
              >
                <i class="ph ph-briefcase" style="font-size: 22px; color: rgb(74, 155, 255); margin-top: 2px;"></i>
                <div style="font-size: 15px; line-height: 1.5;">
                  <span style="font-weight: 700; color: rgb(234, 240, 251); display: inline-block; margin-right: 8px;">Red empresarial</span>{' '}
                  <span style="color: rgb(147, 170, 207);">Establecimientos, sectores y densidad de negocio.</span>
                </div>
              </div>
              <div style="display: flex; align-items: flex-start; gap: 14px; padding: 14px 0px;">
                <i class="ph ph-question" style="font-size: 22px; color: rgb(147, 170, 207); margin-top: 2px;"></i>
                <div style="font-size: 15px; line-height: 1.5;">
                  <span style="font-weight: 700; color: rgb(234, 240, 251); display: inline-block; margin-right: 8px;">¿Necesitas otra capa?</span>{' '}
                  <span style="color: rgb(147, 170, 207);">La levantamos en campo.</span>
                </div>
              </div>
            </div>
          </div>

          <div style="position: relative;">
            <div style="display: flex; align-items: center; justify-content: center;">
