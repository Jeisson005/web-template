---
import BaseLayout from '@/layouts/BaseLayout.astro';
import ContactForm from '@/components/ContactForm.astro';
---

<BaseLayout
  title="Contact | Web Template"
  description="High-performance static contact page connected directly to Payload CMS."
>
  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-16">
    <div class="text-center max-w-2xl mx-auto mb-12">
      <span class="inline-block px-3 py-1 rounded-full text-xs font-semibold bg-emerald-500/10 text-emerald-400 border border-emerald-500/20 uppercase tracking-wider mb-4">
        Direct Channel
      </span>
      <h1 class="text-3xl sm:text-5xl font-extrabold text-white tracking-tight">
        Get in touch
      </h1>
      <p class="mt-4 text-base text-zinc-400 leading-relaxed">
        This form connects directly to the Payload CMS <code class="text-emerald-400 bg-zinc-900 px-1.5 py-0.5 rounded font-mono text-xs">/api/messages</code> REST endpoint with instant feedback and zero framework baggage.
      </p>
    </div>

    <ContactForm />
  </div>
</BaseLayout>
