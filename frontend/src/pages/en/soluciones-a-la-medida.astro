---
import BaseLayout from '@/layouts/BaseLayout.astro';
import ContactSection from '@/components/ContactSection.astro';
---

<BaseLayout
  lang="en"
  title="smartmaps Custom Solutions | When the solution doesn't exist, we build it"
  description="Bespoke GIS solutions and custom APIs built exclusively for your organization."
>
  <div style="background: rgb(255, 255, 255); color: rgb(10, 28, 78); font-family: 'Plus Jakarta Sans', sans-serif;">
    <!-- Hero Section Custom Solutions -->
    <div
      style="background: radial-gradient(80% 100% at 72% 22%, rgb(18, 48, 140) 0%, rgb(10, 28, 78) 46%, rgb(5, 14, 43) 100%); color: rgb(234, 240, 251); padding: 104px 0px 112px;"
    >
      <div style="max-width: 1280px; margin: 0px auto; padding: 0px 40px;">
        <div style="max-width: 820px; margin-top: 14px;">
          <div
            style="display: inline-flex; align-items: center; gap: 10px; font-size: 12px; font-weight: 700; letter-spacing: 2.2px; color: rgb(111, 178, 255); text-transform: uppercase;"
          >
            <span style="padding: 4px 10px; border: 1px solid rgba(111, 178, 255, 0.4); border-radius: 9999px;">03</span>
            smartmaps Custom Solutions
          </div>
          <h1
            style="margin: 20px 0px 0px; font-size: clamp(2rem, 1rem + 3.4vw, 4rem); line-height: 1.05; letter-spacing: -0.02em; font-weight: 800;"
          >
            When the solution<br />doesn't exist, we build it.
          </h1>
          <p
            style="margin: 24px 0px 0px; font-size: 1.125rem; line-height: 1.6; color: rgb(174, 195, 238); max-width: 68ch;"
          >
            Bespoke GIS solutions and custom APIs built exclusively for your organization.
          </p>
          <div style="display: flex; flex-wrap: wrap; gap: 14px; margin-top: 36px;">
            <a
              href="#contacto"
              style="display: inline-flex; align-items: center; height: 48px; padding: 0px 24px; border-radius: 9999px; background: rgb(30, 123, 255); color: rgb(255, 255, 255); font-weight: 700;"
            >
              Custom Developments
            </a>
            <a
              href="#contacto"
              style="display: inline-flex; align-items: center; height: 48px; padding: 0px 24px; border-radius: 9999px; border: 1px solid rgba(111, 178, 255, 0.5); color: rgb(234, 240, 251); font-weight: 600;"
            >
              Talk to an expert
            </a>
          </div>
        </div>
      </div>
    </div>

    <!-- Custom Developments -->
    <div id="desarrollos" style="background: rgb(247, 250, 255); padding: 128px 0px;">
      <div style="max-width: 1280px; margin: 0px auto; padding: 0px 40px;">
        <div style="max-width: 80ch;">
          <div
            style="font-size: 0.75rem; font-weight: 700; letter-spacing: 0.14em; text-transform: uppercase; color: rgb(46, 124, 255);"
          >
            CUSTOM DEVELOPMENTS
          </div>
          <h2
            style="margin: 14px 0px 0px; font-size: clamp(2rem, 1.2rem + 2.4vw, 3rem); line-height: 1.12; letter-spacing: -0.02em; font-weight: 800; color: rgb(10, 28, 78);"
          >
            What isn't available off the shelf, we engineer
          </h2>
          <p style="margin: 18px 0px 0px; font-size: 1.125rem; line-height: 1.6; color: rgb(90, 108, 140);">
            Applications, services, and models crafted for a single client, tailored to their workflows and systems.
          </p>
        </div>

        <div
          style="display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 24px; margin-top: 48px;"
        >
          <!-- Card 1: Apps -->
          <div
            style="background: #FFFFFF; border: 1px solid rgba(10, 23, 51, 0.08); border-radius: 12px; padding: 32px; box-shadow: 0 4px 12px rgba(10, 28, 78, 0.03);"
          >
            <i class="ph ph-device-mobile" style="font-size: 32px; color: rgb(46, 124, 255);"></i>
            <div
              style="font-size: 22px; font-weight: 800; letter-spacing: -0.4px; color: rgb(10, 28, 78); margin-top: 20px;"
            >
              Apps
            </div>
            <div style="font-size: 0.95rem; color: rgb(46, 124, 255); margin-top: 6px;">For field teams.</div>
            <div style="height: 1px; background: rgba(10, 23, 51, 0.08); margin: 20px 0;"></div>
            <ul class="sm-bullet-list">
              <li>Sales and delivery tracking</li>
              <li>Claims and incident surveys</li>
              <li>Merchandiser and route management</li>
            </ul>
          </div>

          <!-- Card 2: APIs -->
          <div
            style="background: #FFFFFF; border: 1px solid rgba(10, 23, 51, 0.08); border-radius: 12px; padding: 32px; box-shadow: 0 4px 12px rgba(10, 28, 78, 0.03);"
          >
            <i class="ph ph-code" style="font-size: 32px; color: rgb(46, 124, 255);"></i>
            <div
              style="font-size: 22px; font-weight: 800; letter-spacing: -0.4px; color: rgb(10, 28, 78); margin-top: 20px;"
            >
              APIs
            </div>
            <div style="font-size: 0.95rem; color: rgb(46, 124, 255); margin-top: 6px;">
              Geolocate your business systems.
            </div>
            <div style="height: 1px; background: rgba(10, 23, 51, 0.08); margin: 20px 0;"></div>
            <ul class="sm-bullet-list">
              <li>Geocoding addresses to coordinates</li>
              <li>Seamless enterprise integration</li>
              <li>Dynamic routing and geolocation</li>
            </ul>
          </div>

          <!-- Card 3: Analytics & Models -->
          <div
            style="background: #FFFFFF; border: 1px solid rgba(10, 23, 51, 0.08); border-radius: 12px; padding: 32px; box-shadow: 0 4px 12px rgba(10, 28, 78, 0.03);"
          >
            <i class="ph ph-robot" style="font-size: 32px; color: rgb(46, 124, 255);"></i>
            <div
              style="font-size: 22px; font-weight: 800; letter-spacing: -0.4px; color: rgb(10, 28, 78); margin-top: 20px;"
            >
              Analytics & Models
            </div>
            <div style="font-size: 0.95rem; color: rgb(46, 124, 255); margin-top: 6px;">From data to decisive action.</div>
            <div style="height: 1px; background: rgba(10, 23, 51, 0.08); margin: 20px 0;"></div>
            <ul class="sm-bullet-list">
              <li>Multivariable correlation</li>
              <li>Process automation</li>
              <li>Predictive models and executive dashboards</li>
            </ul>
          </div>
        </div>
      </div>
    </div>

    <!-- Case Studies -->
    <div style="background: #FFFFFF; padding: 128px 0px;">
      <div style="max-width: 1280px; margin: 0px auto; padding: 0px 40px;">
        <div style="max-width: 800px; margin: 0 0 64px 0;">
          <div
            style="font-size: 0.75rem; font-weight: 700; letter-spacing: 0.14em; text-transform: uppercase; color: rgb(46, 124, 255);"
          >
            CASE STUDIES
          </div>
          <h2
            style="margin: 14px 0px 0px; font-size: clamp(2rem, 1.2rem + 2.4vw, 3rem); line-height: 1.12; letter-spacing: -0.02em; font-weight: 800; color: rgb(10, 28, 78);"
          >
            GIS solutions<br />solving critical enterprise challenges
          </h2>
        </div>

        <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(260px, 1fr)); gap: 24px;">
          <!-- Card 1 -->
          <div
            style="background: rgb(10, 28, 78); border-radius: 12px; padding: 40px 24px; text-align: center; box-shadow: 0 10px 30px rgba(10, 28, 78, 0.08);"
          >
            <div
              style="color: rgb(74, 144, 226); font-size: 0.75rem; font-weight: 700; letter-spacing: 0.1em; text-transform: uppercase; margin-bottom: 20px;"
            >
              ENERGY
            </div>
            <h3
              style="color: #FFFFFF; font-size: 1.25rem; font-weight: 700; line-height: 1.3; margin: 0 0 20px 0;"
            >
              Logistics optimization for the energy sector
            </h3>
            <p style="color: rgb(147, 170, 207); font-size: 1rem; line-height: 1.6; margin: 0; text-align: center;">
              For a leading gas distributor in Latin America, we developed a platform that automates order dispatch
              across transport fleets, significantly cutting final delivery wait times.
            </p>
          </div>

          <!-- Card 2 -->
          <div
            style="background: rgb(10, 28, 78); border-radius: 12px; padding: 40px 24px; text-align: center; box-shadow: 0 10px 30px rgba(10, 28, 78, 0.08);"
          >
            <div
              style="color: rgb(74, 144, 226); font-size: 0.75rem; font-weight: 700; letter-spacing: 0.1em; text-transform: uppercase; margin-bottom: 20px;"
            >
              PHARMACEUTICAL
            </div>
            <h3
              style="color: #FFFFFF; font-size: 1.25rem; font-weight: 700; line-height: 1.3; margin: 0 0 20px 0;"
            >
              GIS system for pharmaceutical distribution
            </h3>
            <p style="color: rgb(147, 170, 207); font-size: 1rem; line-height: 1.6; margin: 0; text-align: center;">
              We implemented an intelligent routing engine for a leading healthcare and pharmaceutical distributor in
              Ecuador, minimizing dispatch planning time and cutting total fleet mileage.
            </p>
          </div>

          <!-- Card 3 -->
          <div
            style="background: rgb(10, 28, 78); border-radius: 12px; padding: 40px 24px; text-align: center; box-shadow: 0 10px 30px rgba(10, 28, 78, 0.08);"
          >
            <div
              style="color: rgb(74, 144, 226); font-size: 0.75rem; font-weight: 700; letter-spacing: 0.1em; text-transform: uppercase; margin-bottom: 20px;"
            >
              POSTAL LOGISTICS
            </div>
            <h3
              style="color: #FFFFFF; font-size: 1.25rem; font-weight: 700; line-height: 1.3; margin: 0 0 20px 0;"
            >
              Last-mile management for national postal service
            </h3>
            <p style="color: rgb(147, 170, 207); font-size: 1rem; line-height: 1.6; margin: 0; text-align: center;">
              For the official postal carrier of a Latin American country, we architected an intelligent parcel
              allocation and route optimization system, speeding up deliveries and providing 360-degree operational
              visibility.
            </p>
          </div>

          <!-- Card 4 -->
          <div
            style="background: rgb(10, 28, 78); border-radius: 12px; padding: 40px 24px; text-align: center; box-shadow: 0 10px 30px rgba(10, 28, 78, 0.08);"
          >
            <div
              style="color: rgb(74, 144, 226); font-size: 0.75rem; font-weight: 700; letter-spacing: 0.1em; text-transform: uppercase; margin-bottom: 20px;"
            >
              COMMERCIAL
            </div>
            <h3
              style="color: #FFFFFF; font-size: 1.25rem; font-weight: 700; line-height: 1.3; margin: 0 0 20px 0;"
            >
              Commercial management app for field sales
            </h3>
            <p style="color: rgb(147, 170, 207); font-size: 1rem; line-height: 1.6; margin: 0; text-align: center;">
              For a leading automotive parts distributor in Central America, we built a mobile tool that digitized the
              entire sales workflow, maximizing field agent productivity and providing real-time oversight.
            </p>
          </div>
        </div>
      </div>
    </div>

    <!-- Contact Form -->
    <ContactSection
      lang="en"
      title="What do you need?"
      subtitle="Tell us the challenge you need solved, and our team will design the right solution."
      secondaryCtaText="Prefer to speak with an expert?"
      secondaryCtaHref="#contacto"
      submitButtonText="Send request"
    />
  </div>
</BaseLayout>
