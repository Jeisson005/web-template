---
import BaseLayout from '@/layouts/BaseLayout.astro';
import IndustryCarousel from '@/components/IndustryCarousel.astro';
import FaqAccordion from '@/components/FaqAccordion.astro';
import ContactSection from '@/components/ContactSection.astro';

const psFaqsEn = [
  {
    q: 'Do you work on my existing Esri licenses?',
    a: 'Yes, and that is the foundational premise of our model. The client retains their licensing, data, and environment. We do not resell licenses.',
  },
  {
    q: 'What geographic coverage is available?',
    a: 'In-house teams in 10 countries across the Americas, with local operations and clients in more than 15 countries.',
  },
  {
    q: 'How do we contract your services?',
    a: 'By project or by block of hours, across the five engagement models on this page: turnkey, staff augmentation, managed services, version upgrade, and training.',
  },
  {
    q: 'Can it integrate with Power BI, CRM, or ERP?',
    a: 'Yes. Seamless integration with ERP, CRM, BI, and core business applications connected to the geospatial environment is one of our four key pillars.',
  },
  {
    q: 'How does it pair with smartmaps Data layers?',
    a: 'Your existing ArcGIS environment delivers higher value when enriched with fresh layers: smartmaps Data layers deploy directly into that exact environment.',
  },
];
---

<BaseLayout
  lang="en"
  title="smartmaps Professional Services | Your Esri licensing, put to work"
  description="Implementation, integration, and extension of GIS capabilities on the Esri platform the client already has contracted."
  ctaText="Schedule an evaluation"
  ctaHref="#contacto"
>
  <div style="background: rgb(255, 255, 255); color: rgb(10, 28, 78); font-family: 'Plus Jakarta Sans', sans-serif;">
    <!-- Hero Section Professional Services -->
    <div
      style="background: radial-gradient(80% 100% at 74% 24%, rgb(26, 62, 150) 0%, rgb(10, 28, 78) 46%, rgb(5, 14, 43) 100%); color: rgb(234, 240, 251); padding: 104px 0px 112px;"
    >
      <div style="max-width: 1280px; margin: 0px auto; padding: 0px 40px;">
        <div style="max-width: 820px; margin-top: 14px;">
          <div
            style="display: inline-flex; align-items: center; gap: 10px; font-size: 12px; font-weight: 700; letter-spacing: 2.2px; color: rgb(111, 178, 255); text-transform: uppercase;"
          >
            <span style="padding: 4px 10px; border: 1px solid rgba(111, 178, 255, 0.4); border-radius: 9999px;">02</span>
            SMARTMAPS PROFESSIONAL SERVICES
          </div>
          <h1
            style="margin: 20px 0px 0px; font-size: clamp(2rem, 1rem + 3.4vw, 4rem); line-height: 1.05; letter-spacing: -0.02em; font-weight: 800; color: #fff;"
          >
            Your Esri licensing,<br />put to work.
          </h1>
          <p
            style="margin: 24px 0px 0px; font-size: 1.125rem; line-height: 1.6; color: rgb(174, 195, 238); max-width: 68ch;"
          >
            Implementation, integration, and extension of GIS capabilities <br />on the Esri platform the client already
            has contracted.
          </p>
          <div style="display: flex; flex-wrap: wrap; gap: 14px; margin-top: 36px;">
            <a
              href="#contacto"
              style="display: inline-flex; align-items: center; height: 48px; padding: 0px 24px; border-radius: 9999px; background: rgb(74, 155, 255); color: rgb(5, 18, 46); font-weight: 700;"
            >
              Schedule an evaluation
            </a>
            <a
              href="#formas"
              style="display: inline-flex; align-items: center; height: 48px; padding: 0px 24px; border-radius: 9999px; border: 1px solid rgba(127, 186, 255, 0.5); color: rgb(234, 240, 251); font-weight: 600;"
            >
              Ways to engage
            </a>
          </div>
        </div>
      </div>
    </div>

    <!-- Who is it for? -->
    <div style="background: rgb(255, 255, 255); padding: 128px 0px;">
      <div style="max-width: 1280px; margin: 0px auto; padding: 0px 40px;">
        <div
          style="display: grid; grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); gap: 48px; align-items: center;"
        >
          <div style="max-width: 68ch;">
            <h2
              style="margin: 0px; font-size: clamp(2rem, 1.2rem + 2.4vw, 3rem); line-height: 1.12; letter-spacing: -0.02em; font-weight: 800;"
            >
              Who is it for?
            </h2>
            <p style="margin: 18px 0px 0px; font-size: 1.125rem; line-height: 1.6; color: rgb(90, 108, 140);">
              For organizations with Esri technology seeking to deploy new services, build system integrations, or
              maximize their operational GIS capabilities.
            </p>
          </div>
          <img
            src="https://i.postimg.cc/y63PBDRr/logos-esri.png"
            alt="Esri Technology"
            style="width: 100%; height: auto; display: block;"
          />
        </div>

        <IndustryCarousel lang="en" theme="light" id="sm-ps-en" />
      </div>
    </div>

    <!-- The Model -->
    <div style="background: rgb(247, 250, 255); padding: 112px 0px;">
      <div style="max-width: 1280px; margin: 0px auto; padding: 0px 40px;">
        <div
          style="background: rgb(10, 23, 51); border-radius: 24px; overflow: hidden; display: grid; grid-template-columns: repeat(auto-fit, minmax(320px, 1fr)); align-items: stretch;"
        >
          <div
            style="padding: clamp(28px, 4vw, 56px); display: flex; flex-direction: column; justify-content: center;"
          >
            <div
              style="font-size: 0.75rem; font-weight: 700; letter-spacing: 0.14em; text-transform: uppercase; color: rgb(127, 186, 255);"
            >
              The model
            </div>
            <p
              style="margin: 22px 0px 0px; font-size: clamp(1.5rem, 1rem + 1.5vw, 2.125rem); line-height: 1.28; letter-spacing: -0.02em; font-weight: 700; color: rgb(234, 240, 251); max-width: 34ch; text-wrap: pretty;"
            >
              The client retains their licensing, data, and environment.<br />We provide the team, methodology, and
              certification to make it produce.
            </p>
            <div
              style="margin-top: 28px; font-size: 1.0625rem; line-height: 1.6; color: rgb(174, 195, 238); max-width: 48ch;"
            >
              We leverage your existing licensing to work directly within your Esri environment.
            </div>
          </div>
          <div
            style="background: rgb(255, 255, 255); display: flex; align-items: center; justify-content: center; padding: 40px; border-left: 1px solid rgba(10, 23, 51, 0.08);"
          >
            <img
              src="https://i.postimg.cc/SQY8BDZJ/web-iso-dashboards.png"
              alt="Teams collaborating on geospatial dashboards and data models"
              style="width: 100%; max-width: 380px; height: auto; display: block;"
            />
          </div>
        </div>
      </div>
    </div>

    <!-- What we do -->
    <div style="background: rgb(255, 255, 255); padding: 112px 0px;">
      <div style="max-width: 1280px; margin: 0px auto; padding: 0px 40px;">
        <div style="max-width: 68ch;">
          <div
            style="font-size: 0.75rem; font-weight: 700; letter-spacing: 0.14em; text-transform: uppercase; color: rgb(46, 124, 255);"
          >
            What we do
          </div>
          <h2
            style="margin: 14px 0px 0px; font-size: clamp(2rem, 1.2rem + 2.4vw, 3rem); line-height: 1.12; letter-spacing: -0.02em; font-weight: 800;"
          >
            Four core work streams.
          </h2>
        </div>
        <div
          style="display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 18px; margin-top: 48px;"
        >
          <div
            style="border: 1px solid rgba(10, 23, 51, 0.08); border-radius: 16px; padding: 28px; box-shadow: rgba(6, 13, 34, 0.04) 0px 1px 2px; transition: transform 0.2s, border-color 0.2s;"
          >
            <i class="ph ph-stack" style="font-size: 26px; color: rgb(19, 73, 216);"></i>
            <div style="font-size: 17px; font-weight: 700; margin-top: 16px;">Implementation & Deployment</div>
            <div style="font-size: 1.0625rem; line-height: 1.6; color: rgb(90, 108, 140); margin-top: 8px;">
              ArcGIS architecture, installation, configuration, and go-live.
            </div>
          </div>
          <div
            style="border: 1px solid rgba(10, 23, 51, 0.08); border-radius: 16px; padding: 28px; box-shadow: rgba(6, 13, 34, 0.04) 0px 1px 2px; transition: transform 0.2s, border-color 0.2s;"
          >
            <i class="ph ph-database" style="font-size: 26px; color: rgb(19, 73, 216);"></i>
            <div style="font-size: 17px; font-weight: 700; margin-top: 16px;">Data Migration & Modeling</div>
            <div style="font-size: 1.0625rem; line-height: 1.6; color: rgb(90, 108, 140); margin-top: 8px;">
              Data conversion, geodatabase design, and corporate data models.
            </div>
          </div>
          <div
            style="border: 1px solid rgba(10, 23, 51, 0.08); border-radius: 16px; padding: 28px; box-shadow: rgba(6, 13, 34, 0.04) 0px 1px 2px; transition: transform 0.2s, border-color 0.2s;"
          >
            <i class="ph ph-plugs-connected" style="font-size: 26px; color: rgb(19, 73, 216);"></i>
            <div style="font-size: 17px; font-weight: 700; margin-top: 16px;">System Integrations</div>
            <div style="font-size: 1.0625rem; line-height: 1.6; color: rgb(90, 108, 140); margin-top: 8px;">
              ERP, CRM, BI, and business applications linked to the geospatial environment.
            </div>
          </div>
          <div
            style="border: 1px solid rgba(10, 23, 51, 0.08); border-radius: 16px; padding: 28px; box-shadow: rgba(6, 13, 34, 0.04) 0px 1px 2px; transition: transform 0.2s, border-color 0.2s;"
          >
            <i class="ph ph-cpu" style="font-size: 26px; color: rgb(19, 73, 216);"></i>
            <div style="font-size: 17px; font-weight: 700; margin-top: 16px;">Extensions & AI Automation</div>
            <div style="font-size: 1.0625rem; line-height: 1.6; color: rgb(90, 108, 140); margin-top: 8px;">
              Widgets, geoprocessing tools, and models that extend out-of-the-box ArcGIS.
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- Five ways to engage -->
    <div id="formas" style="background: rgb(247, 250, 255); padding: 112px 0px;">
      <div style="max-width: 1280px; margin: 0px auto; padding: 0px 40px;">
        <div style="max-width: 80ch;">
          <h2
            style="margin: 0px; font-size: clamp(2rem, 1.2rem + 2.4vw, 3rem); line-height: 1.12; letter-spacing: -0.02em; font-weight: 800; color: rgb(10, 28, 78);"
          >
            Five ways to engage our services
          </h2>
          <p style="margin: 18px 0px 0px; font-size: 1.125rem; line-height: 1.6; color: rgb(90, 108, 140);">
            The standard model used by Esri professional service partners worldwide:<br />consulting, implementation,
            integration, support, and training.
          </p>
        </div>

        <div
          style="display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 16px; margin-top: 48px; align-items: stretch;"
        >
          <div
            style="background: #ffffff; border: 1px solid rgba(46, 124, 255, 0.15); border-radius: 12px; padding: 24px; box-shadow: 0 4px 12px rgba(10, 28, 78, 0.03);"
          >
            <i class="ph ph-map-trifold" style="font-size: 28px; color: rgb(46, 124, 255);"></i>
            <div
              style="font-size: 17px; font-weight: 700; color: rgb(10, 28, 78); margin-top: 16px; line-height: 1.3;"
            >
              Turnkey Project
            </div>
            <div style="font-size: 14.5px; line-height: 1.5; color: rgb(90, 108, 140); margin-top: 12px;">
              Fixed scope, timeline, and defined deliverables.
            </div>
          </div>
          <div
            style="background: #ffffff; border: 1px solid rgba(46, 124, 255, 0.15); border-radius: 12px; padding: 24px; box-shadow: 0 4px 12px rgba(10, 28, 78, 0.03);"
          >
            <i class="ph ph-users-three" style="font-size: 28px; color: rgb(46, 124, 255);"></i>
            <div
              style="font-size: 17px; font-weight: 700; color: rgb(10, 28, 78); margin-top: 16px; line-height: 1.3;"
            >
              Staff Augmentation
            </div>
            <div style="font-size: 14.5px; line-height: 1.5; color: rgb(90, 108, 140); margin-top: 12px;">
              Dedicated GIS specialists embedded in your team for a set term.
            </div>
          </div>
          <div
            style="background: #ffffff; border: 1px solid rgba(46, 124, 255, 0.15); border-radius: 12px; padding: 24px; box-shadow: 0 4px 12px rgba(10, 28, 78, 0.03);"
          >
            <i class="ph ph-lifebuoy" style="font-size: 28px; color: rgb(46, 124, 255);"></i>
            <div
              style="font-size: 17px; font-weight: 700; color: rgb(10, 28, 78); margin-top: 16px; line-height: 1.3;"
            >
              Managed Services
            </div>
            <div style="font-size: 14.5px; line-height: 1.5; color: rgb(90, 108, 140); margin-top: 12px;">
              Ongoing operation and administration of your ArcGIS environment.
            </div>
          </div>
          <div
            style="background: #ffffff; border: 1px solid rgba(46, 124, 255, 0.15); border-radius: 12px; padding: 24px; box-shadow: 0 4px 12px rgba(10, 28, 78, 0.03);"
          >
            <i class="ph ph-cloud-arrow-up" style="font-size: 28px; color: rgb(46, 124, 255);"></i>
            <div
              style="font-size: 17px; font-weight: 700; color: rgb(10, 28, 78); margin-top: 16px; line-height: 1.3;"
            >
              Version Upgrades
            </div>
            <div style="font-size: 14.5px; line-height: 1.5; color: rgb(90, 108, 140); margin-top: 12px;">
              Migration to new releases without operational interruption.
            </div>
          </div>
          <div
            style="background: #ffffff; border: 1px solid rgba(46, 124, 255, 0.15); border-radius: 12px; padding: 24px; box-shadow: 0 4px 12px rgba(10, 28, 78, 0.03);"
          >
            <i class="ph ph-graduation-cap" style="font-size: 28px; color: rgb(46, 124, 255);"></i>
            <div
              style="font-size: 17px; font-weight: 700; color: rgb(10, 28, 78); margin-top: 16px; line-height: 1.3;"
            >
              Training & Adoption
            </div>
            <div style="font-size: 14.5px; line-height: 1.5; color: rgb(90, 108, 140); margin-top: 12px;">
              Comprehensive training for business users and administrators.
            </div>
          </div>
        </div>

        <div
          style="margin-top: 24px; background: rgb(238, 244, 255); border: 1px solid rgb(217, 228, 248); border-radius: 12px; padding: 20px 24px; display: flex; align-items: center; gap: 16px;"
        >
          <i class="ph ph-certificate" style="font-size: 24px; color: rgb(46, 124, 255);"></i>
          <div style="font-size: 15px; font-weight: 500; color: rgb(10, 28, 78); line-height: 1.5;">
            We operate within the ESRI ecosystem, with in-house teams across more than 10 countries in the Americas
          </div>
        </div>
      </div>
    </div>

    <!-- Backing Section -->
    <div style="background: rgb(5, 14, 43); color: rgb(234, 240, 251); padding: 128px 0px;">
      <div
        style="max-width: 1280px; margin: 0px auto; padding: 0px 40px; display: grid; grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); gap: 48px; align-items: center;"
      >
        <div>
          <div
            style="font-size: 0.75rem; font-weight: 700; letter-spacing: 0.14em; text-transform: uppercase; color: rgb(127, 186, 255);"
          >
            Backing
          </div>
          <p
            style="margin: 22px 0px 0px; font-size: clamp(1.375rem, 1.1rem + 1vw, 1.75rem); line-height: 1.3; font-weight: 700; letter-spacing: -0.02em; max-width: 44ch; text-wrap: pretty;"
          >
            We ensure success with in-house resources, retaining the same team from implementation through operations.
          </p>
        </div>
        <div
          style="display: flex; flex-direction: column; gap: 2px; border: 1px solid rgba(255, 255, 255, 0.08); border-radius: 24px; overflow: hidden;"
        >
          <div
            style="display: flex; align-items: flex-start; gap: 14px; padding: 22px 24px; background: rgba(255, 255, 255, 0.02);"
          >
            <i
              class="ph ph-certificate"
              style="flex: 0 0 auto; font-size: 20px; color: rgb(127, 186, 255); margin-top: 3px;"></i>
            <div style="font-size: 1.0625rem; line-height: 1.6; color: rgb(174, 195, 238);">
              Official partner of the Esri ecosystem.
            </div>
          </div>
          <div
            style="display: flex; align-items: flex-start; gap: 14px; padding: 22px 24px; background: rgba(255, 255, 255, 0.02);"
          >
            <i
              class="ph ph-globe-hemisphere-west"
              style="flex: 0 0 auto; font-size: 20px; color: rgb(127, 186, 255); margin-top: 3px;"></i>
            <div style="font-size: 1.0625rem; line-height: 1.6; color: rgb(174, 195, 238);">
              Dedicated regional teams with local operations across the Americas.
            </div>
          </div>
          <div
            style="display: flex; align-items: flex-start; gap: 14px; padding: 22px 24px; background: rgba(255, 255, 255, 0.02);"
          >
            <i
              class="ph ph-lock-key"
              style="flex: 0 0 auto; font-size: 20px; color: rgb(127, 186, 255); margin-top: 3px;"></i>
            <div style="font-size: 1.0625rem; line-height: 1.6; color: rgb(174, 195, 238);">
              Licensing, data, and infrastructure remain 100% owned by the client.
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- Frequently Asked Questions -->
    <div style="background: rgb(247, 250, 255); padding: 112px 0px;">
      <div style="max-width: 1280px; margin: 0px auto; padding: 0px 40px;">
        <div style="max-width: 68ch;">
          <div
            style="font-size: 0.75rem; font-weight: 700; letter-spacing: 0.14em; text-transform: uppercase; color: rgb(46, 124, 255);"
          >
            Frequently asked questions
          </div>
          <h2
            style="margin: 14px 0px 0px; font-size: clamp(2rem, 1.2rem + 2.4vw, 3rem); line-height: 1.12; letter-spacing: -0.02em; font-weight: 800;"
          >
            Questions asked before the evaluation.
          </h2>
        </div>

        <FaqAccordion items={psFaqsEn} id="ps-faqs-en" />
      </div>
    </div>

    <!-- Data link -->
    <div style="background: rgb(255, 255, 255); padding: 0px 0px 112px;">
      <div
        style="max-width: 1280px; margin: 0px auto; padding: 112px 40px 0px; border-top: 1px solid rgb(227, 234, 246);"
      >
        <a
          href="/en/data"
          style="display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 24px; background: rgb(255, 255, 255); border: 1px solid rgba(30, 123, 255, 0.3); border-radius: 24px; padding: 40px; color: rgb(10, 28, 78);"
        >
          <div style="max-width: 60ch;">
            <div
              style="font-size: clamp(1.375rem, 1.1rem + 1vw, 1.75rem); line-height: 1.25; font-weight: 800; letter-spacing: -0.3px;"
            >
              Your ArcGIS environment delivers higher ROI with fresh layers.
            </div>
          </div>
          <div
            style="flex: 0 0 auto; display: inline-flex; align-items: center; gap: 10px; height: 48px; padding: 0px 24px; border-radius: 9999px; background: rgb(19, 73, 216); color: rgb(255, 255, 255); font-weight: 600;"
          >
            smartmaps Data <i class="ph ph-arrow-right" style="font-size: 15px;"></i>
          </div>
        </a>
      </div>
    </div>

    <!-- Contact Form -->
    <ContactSection
      lang="en"
      bgGradient="radial-gradient(70% 100% at 78% 20%, rgb(26, 62, 150) 0%, rgb(10, 28, 78) 46%, rgb(5, 14, 43) 100%)"
      title="Schedule an evaluation of your ArcGIS environment."
      subtitle="We review architecture, data models, and integrations, and identify what should be activated first."
      secondaryCtaText="Prefer to speak with an expert?"
      secondaryCtaHref="#contacto"
      submitButtonText="Schedule an evaluation"
    />
  </div>
</BaseLayout>
