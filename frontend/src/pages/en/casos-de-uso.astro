---
import BaseLayout from '@/layouts/BaseLayout.astro';
import ContactSection from '@/components/ContactSection.astro';
---

<BaseLayout
  lang="en"
  title="smartmaps Use Cases | Decisions powered by territorial evidence"
  description="Strategic decisions in Retail, Banking, Consumer Goods, and Real Estate backed with precise geospatial evidence."
>
  <div style="background: rgb(255, 255, 255); color: rgb(10, 28, 78); font-family: 'Plus Jakarta Sans', sans-serif;">
    <!-- Hero Section Use Cases -->
    <div
      style="background: radial-gradient(80% 100% at 72% 22%, rgb(18, 48, 140) 0%, rgb(10, 28, 78) 46%, rgb(5, 14, 43) 100%); color: rgb(234, 240, 251); padding: 128px 0px 144px;"
    >
      <div style="max-width: 1280px; margin: 0px auto; padding: 0px 40px;">
        <div style="max-width: 820px;">
          <h1
            style="margin: 0px; font-size: clamp(2.2rem, 1rem + 3.6vw, 4.1rem); line-height: 1.05; letter-spacing: -0.02em; font-weight: 800;"
          >
            Use cases
          </h1>
          <p
            style="margin: 24px 0px 0px; font-size: 1.125rem; line-height: 1.6; color: rgb(174, 195, 238); max-width: 68ch;"
          >
            Decisions powered by territorial evidence.
          </p>
        </div>
      </div>
    </div>

    <!-- Use Cases Content Details -->
    <div style="background: rgb(255, 255, 255); padding: 112px 0px;">
      <div
        style="max-width: 1280px; margin: 0px auto; padding: 0px 40px; display: flex; flex-direction: column; gap: 40px;"
      >
        <!-- Case 1: Retail -->
        <div
          style="border: 1px solid rgba(10, 23, 51, 0.08); border-radius: 24px; padding: 40px; display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 40px; box-shadow: rgba(6, 13, 34, 0.04) 0px 1px 2px;"
        >
          <div>
            <div style="font-size: 0.75rem; font-weight: 700; letter-spacing: 0.14em; color: rgb(46, 124, 255);">
              RETAIL
            </div>
            <div
              style="margin-top: 12px; font-size: clamp(1.375rem, 1.1rem + 1vw, 1.75rem); line-height: 1.25; font-weight: 800; letter-spacing: -0.3px;"
            >
              Store Network Expansion
            </div>
            <div
              style="margin-top: 26px; font-size: clamp(2rem, 4vw, 3rem); font-weight: 800; line-height: 1; letter-spacing: -0.03em; color: rgb(19, 73, 216);"
            >
              +12% revenue per new location
            </div>
            <div
              style="font-size: 0.875rem; line-height: 1.5; color: rgb(90, 108, 140); margin-top: 14px; max-width: 44ch;"
            >
              Reference metrics observed in portfolio projects; validated case by case.
            </div>
          </div>
          <div>
            <div style="font-size: 1.0625rem; line-height: 1.6; color: rgb(10, 28, 78); max-width: 68ch;">
              Opening without evidence costs revenue and wasted leases. With commercial attractiveness and mobility, sites
              are selected based on proven potential.
            </div>
            <div
              style="font-size: 0.75rem; font-weight: 700; letter-spacing: 0.14em; text-transform: uppercase; color: rgb(90, 108, 140); margin-top: 30px;"
            >
              Layers powering this decision
            </div>
            <div style="display: flex; flex-wrap: wrap; gap: 9px; margin-top: 14px;">
              <a
                href="/en/data#capas"
                style="padding: 9px 16px; border-radius: 9999px; background: rgb(242, 246, 254); border: 1px solid rgba(30, 123, 255, 0.2); font-size: 13.5px; font-weight: 600; color: rgb(19, 73, 216);"
              >
                Commercial attractiveness
              </a>
              <a
                href="/en/data#capas"
                style="padding: 9px 16px; border-radius: 9999px; background: rgb(242, 246, 254); border: 1px solid rgba(30, 123, 255, 0.2); font-size: 13.5px; font-weight: 600; color: rgb(19, 73, 216);"
              >
                Mobility
              </a>
              <a
                href="/en/data#capas"
                style="padding: 9px 16px; border-radius: 9999px; background: rgb(242, 246, 254); border: 1px solid rgba(30, 123, 255, 0.2); font-size: 13.5px; font-weight: 600; color: rgb(19, 73, 216);"
              >
                Business network
              </a>
              <a
                href="/en/data#capas"
                style="padding: 9px 16px; border-radius: 9999px; background: rgb(242, 246, 254); border: 1px solid rgba(30, 123, 255, 0.2); font-size: 13.5px; font-weight: 600; color: rgb(19, 73, 216);"
              >
                Sociodemographics
              </a>
            </div>
            <a
              href="#contacto"
              style="display: inline-flex; align-items: center; gap: 9px; height: 48px; padding: 0px 24px; margin-top: 32px; border-radius: 9999px; border: 1px solid rgb(19, 73, 216); color: rgb(19, 73, 216); font-weight: 600; transition: opacity 0.2s;"
            >
              Talk to an expert <i class="ph ph-arrow-right" style="font-size: 15px;"></i>
            </a>
          </div>
        </div>

        <!-- Case 2: Banking & Insurance -->
        <div
          style="border: 1px solid rgba(10, 23, 51, 0.08); border-radius: 24px; padding: 40px; display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 40px; box-shadow: rgba(6, 13, 34, 0.04) 0px 1px 2px;"
        >
          <div>
            <div style="font-size: 0.75rem; font-weight: 700; letter-spacing: 0.14em; color: rgb(46, 124, 255);">
              BANKING & INSURANCE
            </div>
            <div
              style="margin-top: 12px; font-size: clamp(1.375rem, 1.1rem + 1vw, 1.75rem); line-height: 1.25; font-weight: 800; letter-spacing: -0.3px;"
            >
              Scoring with Territorial Context
            </div>
            <div
              style="margin-top: 26px; font-size: clamp(2rem, 4vw, 3rem); font-weight: 800; line-height: 1; letter-spacing: -0.03em; color: rgb(19, 73, 216);"
            >
              95% census accuracy
            </div>
            <div
              style="font-size: 0.875rem; line-height: 1.5; color: rgb(90, 108, 140); margin-top: 14px; max-width: 44ch;"
            >
              Reference metrics observed in portfolio projects; validated case by case.
            </div>
          </div>
          <div>
            <div style="font-size: 1.0625rem; line-height: 1.6; color: rgb(10, 28, 78); max-width: 68ch;">
              An address reveals more than a form: surrounding environment, income, and business density enrich risk
              models.
            </div>
            <div
              style="font-size: 0.75rem; font-weight: 700; letter-spacing: 0.14em; text-transform: uppercase; color: rgb(90, 108, 140); margin-top: 30px;"
            >
              Layers powering this decision
            </div>
            <div style="display: flex; flex-wrap: wrap; gap: 9px; margin-top: 14px;">
              <a
                href="/en/data#capas"
                style="padding: 9px 16px; border-radius: 9999px; background: rgb(242, 246, 254); border: 1px solid rgba(30, 123, 255, 0.2); font-size: 13.5px; font-weight: 600; color: rgb(19, 73, 216);"
              >
                Built environment / Real Estate
              </a>
              <a
                href="/en/data#capas"
                style="padding: 9px 16px; border-radius: 9999px; background: rgb(242, 246, 254); border: 1px solid rgba(30, 123, 255, 0.2); font-size: 13.5px; font-weight: 600; color: rgb(19, 73, 216);"
              >
                Sociodemographics
              </a>
              <a
                href="/en/data#capas"
                style="padding: 9px 16px; border-radius: 9999px; background: rgb(242, 246, 254); border: 1px solid rgba(30, 123, 255, 0.2); font-size: 13.5px; font-weight: 600; color: rgb(19, 73, 216);"
              >
                Business network
              </a>
            </div>
            <a
              href="#contacto"
              style="display: inline-flex; align-items: center; gap: 9px; height: 48px; padding: 0px 24px; margin-top: 32px; border-radius: 9999px; border: 1px solid rgb(19, 73, 216); color: rgb(19, 73, 216); font-weight: 600; transition: opacity 0.2s;"
            >
              Talk to an expert <i class="ph ph-arrow-right" style="font-size: 15px;"></i>
            </a>
          </div>
        </div>

        <!-- Case 3: Consumer Goods -->
        <div
          style="border: 1px solid rgba(10, 23, 51, 0.08); border-radius: 24px; padding: 40px; display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 40px; box-shadow: rgba(6, 13, 34, 0.04) 0px 1px 2px;"
        >
          <div>
            <div style="font-size: 0.75rem; font-weight: 700; letter-spacing: 0.14em; color: rgb(46, 124, 255);"
              >CONSUMER GOODS</div
            >
            <div
              style="margin-top: 12px; font-size: clamp(1.375rem, 1.1rem + 1vw, 1.75rem); line-height: 1.25; font-weight: 800; letter-spacing: -0.3px;"
            >
              Distribution Coverage
            </div>
            <div
              style="margin-top: 26px; font-size: clamp(2rem, 4vw, 3rem); font-weight: 800; line-height: 1; letter-spacing: -0.03em; color: rgb(19, 73, 216);"
            >
              +24% distribution margin
            </div>
            <div
              style="font-size: 0.875rem; line-height: 1.5; color: rgb(90, 108, 140); margin-top: 14px; max-width: 44ch;"
            >
              Reference metrics observed in portfolio projects; validated case by case.
            </div>
          </div>
          <div>
            <div style="font-size: 1.0625rem; line-height: 1.6; color: rgb(10, 28, 78); max-width: 68ch;">
              Legacy routes leave untapped areas. Territories are optimized based on business density and actual demand.
            </div>
            <div
              style="font-size: 0.75rem; font-weight: 700; letter-spacing: 0.14em; text-transform: uppercase; color: rgb(90, 108, 140); margin-top: 30px;"
            >
              Layers powering this decision
            </div>
            <div style="display: flex; flex-wrap: gap: 9px; margin-top: 14px;">
              <a
                href="/en/data#capas"
                style="padding: 9px 16px; border-radius: 9999px; background: rgb(242, 246, 254); border: 1px solid rgba(30, 123, 255, 0.2); font-size: 13.5px; font-weight: 600; color: rgb(19, 73, 216);"
              >
                Business network
              </a>
              <a
                href="/en/data#capas"
                style="padding: 9px 16px; border-radius: 9999px; background: rgb(242, 246, 254); border: 1px solid rgba(30, 123, 255, 0.2); font-size: 13.5px; font-weight: 600; color: rgb(19, 73, 216);"
              >
                Sociodemographics
              </a>
              <a
                href="/en/data#capas"
                style="padding: 9px 16px; border-radius: 9999px; background: rgb(242, 246, 254); border: 1px solid rgba(30, 123, 255, 0.2); font-size: 13.5px; font-weight: 600; color: rgb(19, 73, 216);"
              >
                POIs
              </a>
            </div>
            <a
              href="#contacto"
              style="display: inline-flex; align-items: center; gap: 9px; height: 48px; padding: 0px 24px; margin-top: 32px; border-radius: 9999px; border: 1px solid rgb(19, 73, 216); color: rgb(19, 73, 216); font-weight: 600; transition: opacity 0.2s;"
            >
              Talk to an expert <i class="ph ph-arrow-right" style="font-size: 15px;"></i>
            </a>
          </div>
        </div>

        <!-- Case 4: Real Estate & OOH -->
        <div
          style="border: 1px solid rgba(10, 23, 51, 0.08); border-radius: 24px; padding: 40px; display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 40px; box-shadow: rgba(6, 13, 34, 0.04) 0px 1px 2px;"
        >
          <div>
            <div style="font-size: 0.75rem; font-weight: 700; letter-spacing: 0.14em; color: rgb(46, 124, 255);">
              REAL ESTATE & OOH
            </div>
            <div
              style="margin-top: 12px; font-size: clamp(1.375rem, 1.1rem + 1vw, 1.75rem); line-height: 1.25; font-weight: 800; letter-spacing: -0.3px;"
            >
              Valuation & Exposure
            </div>
            <div
              style="margin-top: 26px; font-size: clamp(2rem, 4vw, 3rem); font-weight: 800; line-height: 1; letter-spacing: -0.03em; color: rgb(19, 73, 216);"
            >
              +32% VAC in outdoor advertising
            </div>
            <div
              style="font-size: 0.875rem; line-height: 1.5; color: rgb(90, 108, 140); margin-top: 14px; max-width: 44ch;"
            >
              Reference metrics observed in portfolio projects; validated case by case.
            </div>
          </div>
          <div>
            <div style="font-size: 1.0625rem; line-height: 1.6; color: rgb(10, 28, 78); max-width: 68ch;">
              Value depends on foot traffic and audience profile. Mobility and demographics turn it into a defensible
              figure.
            </div>
            <div
              style="font-size: 0.75rem; font-weight: 700; letter-spacing: 0.14em; text-transform: uppercase; color: rgb(90, 108, 140); margin-top: 30px;"
            >
              Layers powering this decision
            </div>
            <div style="display: flex; flex-wrap: wrap; gap: 9px; margin-top: 14px;">
              <a
                href="/en/data#capas"
                style="padding: 9px 16px; border-radius: 9999px; background: rgb(242, 246, 254); border: 1px solid rgba(30, 123, 255, 0.2); font-size: 13.5px; font-weight: 600; color: rgb(19, 73, 216);"
              >
                Mobility
              </a>
              <a
                href="/en/data#capas"
                style="padding: 9px 16px; border-radius: 9999px; background: rgb(242, 246, 254); border: 1px solid rgba(30, 123, 255, 0.2); font-size: 13.5px; font-weight: 600; color: rgb(19, 73, 216);"
              >
                Built environment / Real Estate
              </a>
              <a
                href="/en/data#capas"
                style="padding: 9px 16px; border-radius: 9999px; background: rgb(242, 246, 254); border: 1px solid rgba(30, 123, 255, 0.2); font-size: 13.5px; font-weight: 600; color: rgb(19, 73, 216);"
              >
                Tourism
              </a>
            </div>
            <a
              href="#contacto"
              style="display: inline-flex; align-items: center; gap: 9px; height: 48px; padding: 0px 24px; margin-top: 32px; border-radius: 9999px; border: 1px solid rgb(19, 73, 216); color: rgb(19, 73, 216); font-weight: 600; transition: opacity 0.2s;"
            >
              Talk to an expert <i class="ph ph-arrow-right" style="font-size: 15px;"></i>
            </a>
          </div>
        </div>
      </div>
    </div>

    <!-- Contact Form -->
    <ContactSection
      lang="en"
      title="Tell us your business challenge."
      subtitle="We don't sell generic software. We understand your industry, analyze which spatial layers and models create tangible ROI, and engineer a profitable solution for your business."
      secondaryCtaText="info@intelligisgroup.com"
      secondaryCtaHref="mailto:info@intelligisgroup.com"
      submitButtonText="Send request"
    />
  </div>
</BaseLayout>
