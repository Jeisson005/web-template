---
interface FaqItem {
  question: string;
  answer: string;
}

interface Props {
  items: FaqItem[];
  title?: string;
  subtitle?: string;
}

const { items, title, subtitle } = Astro.props;
---

<section class="w-full max-w-4xl mx-auto py-12 px-4">
  {title && <h2 class="text-3xl font-extrabold text-center mb-3 text-slate-900">{title}</h2>}
  {subtitle && <p class="text-base text-slate-600 text-center mb-8">{subtitle}</p>}

  <div class="flex flex-col gap-4">
    {items.map((item, index) => (
      <details class="group bg-white border border-slate-200 rounded-xl overflow-hidden transition-all duration-200 open:shadow-sm">
        <summary class="flex justify-between items-center p-5 cursor-pointer select-none font-semibold text-slate-800 text-lg hover:text-blue-600 list-none">
          <span>{item.question}</span>
          <span class="ml-4 flex-shrink-0 transition-transform duration-200 group-open:rotate-180 text-slate-400 group-hover:text-blue-600">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
            </svg>
          </span>
        </summary>
        <div class="px-5 pb-5 pt-1 text-slate-600 leading-relaxed text-base border-t border-slate-100">
          <p>{item.answer}</p>
        </div>
      </details>
    ))}
  </div>
</section>
