---
import { CMS_ADMIN_URL } from '@/lib/config';

interface Props {
  currentPath?: string;
}

const { currentPath = '/' } = Astro.props;

const navItems = [
  { href: '/', label: 'Home' },
  { href: '/contact', label: 'Contact' },
  { href: CMS_ADMIN_URL, label: 'CMS Admin', external: true },
];
---

<header class="sticky top-0 z-40 w-full backdrop-blur-md bg-zinc-950/80 border-b border-zinc-800/80">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 h-16 flex items-center justify-between">
    <div class="flex items-center gap-3">
      <a href="/" class="flex items-center gap-2.5 group">
        <div class="w-8 h-8 rounded-lg bg-emerald-500 flex items-center justify-center font-bold text-zinc-950 text-sm shadow-md shadow-emerald-500/20 group-hover:scale-105 transition-transform">
          W
        </div>
        <span class="font-bold text-base tracking-tight text-white">
          Web<span class="text-emerald-400">Template</span>
        </span>
      </a>
    </div>

    <!-- Navigation links -->
    <nav class="flex items-center gap-1 sm:gap-2">
      {navItems.map((item) => (
        <a
          href={item.href}
          target={item.external ? '_blank' : undefined}
          rel={item.external ? 'noopener noreferrer' : undefined}
          class:list={[
            "px-3 py-1.5 rounded-lg text-sm font-medium transition-colors flex items-center gap-1",
            currentPath === item.href
              ? "text-emerald-400 bg-emerald-500/10"
              : "text-zinc-400 hover:text-zinc-100 hover:bg-zinc-800/60"
          ]}
        >
          {item.label}
          {item.external && (
            <svg class="w-3.5 h-3.5 opacity-60" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
            </svg>
          )}
        </a>
      ))}

      <!-- Search Trigger -->
      <button
        id="search-trigger"
        type="button"
        aria-label="Search site"
        class="ml-2 p-2 rounded-lg text-zinc-400 hover:text-white hover:bg-zinc-800/80 transition-colors"
      >
        <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
        </svg>
      </button>
    </nav>
  </div>
</header>
