---
interface Props {
  lang?: 'es' | 'en';
  title?: string;
  subtitle?: string;
  secondaryCtaText?: string;
  secondaryCtaHref?: string;
  submitButtonText?: string;
  bgGradient?: string;
}

const {
  lang = 'es',
  title = lang === 'es' ? 'Pide una muestra con tus propios datos.' : 'Request a sample with your own data.',
  subtitle = lang === 'es'
    ? 'Cuéntanos tu industria y te enviamos una muestra de las capas que aplican a tu caso, o agendamos una conversación de proyecto.'
    : 'Tell us your industry and we will send you a sample of the layers relevant to your case, or schedule a project conversation.',
  secondaryCtaText = lang === 'es' ? '¿Prefieres hablar con un experto?' : 'Prefer to speak with an expert?',
  secondaryCtaHref = '#contacto',
  submitButtonText = lang === 'es' ? 'Quiero mi demo personalizada gratis' : 'Get my free custom demo',
  bgGradient = 'radial-gradient(70% 100% at 78% 20%, rgb(18, 48, 140) 0%, rgb(10, 28, 78) 46%, rgb(5, 14, 43) 100%)',
} = Astro.props;

const isEs = lang === 'es';

const countries = [
  'Colombia',
  'México',
  'Argentina',
  'Bolivia',
  'Brasil',
  'Chile',
  'Costa Rica',
  'Cuba',
  'Ecuador',
  'El Salvador',
  'España',
  'Guatemala',
  'Guayana Francesa',
  'Granada',
  'Guayana',
  'Haití',
  'Honduras',
  'Jamaica',
  'Nicaragua',
  'Panamá',
  'Paraguay',
  'Perú',
  'Puerto Rico',
  'Rep. Dominicana',
  'Surinam',
  'Uruguay',
  'USA',
  'Venezuela',
  'Otro',
];
---

<div
  id="contacto"
  style={`background: ${bgGradient}; color: rgb(234, 240, 251); padding: 144px 0px;`}
>
  <div style="max-width: 1280px; margin: 0px auto; padding: 0px 40px;">
    <div
      style="display: grid; grid-template-columns: repeat(auto-fit, minmax(320px, 1fr)); gap: 64px; align-items: center;"
    >
      <div>
        <h2
          style="margin: 0px; font-size: clamp(2rem, 1.2rem + 2.4vw, 3rem); line-height: 1.12; letter-spacing: -0.02em; font-weight: 800;"
        >
          {title}
        </h2>
        <p style="margin: 18px 0px 0px; font-size: 1.125rem; line-height: 1.6; color: rgb(174, 195, 238);">
          {subtitle}
        </p>
        <div style="margin-top: 36px;">
          <a
            href={secondaryCtaHref}
            style="display: inline-flex; align-items: center; height: 48px; padding: 0px 24px; border-radius: 9999px; border: 1px solid rgba(111, 178, 255, 0.5); color: rgb(234, 240, 251); font-weight: 600;"
          >
            {secondaryCtaText}
          </a>
        </div>
      </div>

      <div
        style="background: #FFFFFF; border-radius: 12px; padding: 32px; color: #0A1C4E; box-shadow: 0 20px 40px rgba(0,0,0,0.2);"
      >
        <form class="smartmaps-contact-form" style="margin: 0;">
          <!-- Hidden Zoho CRM Web-to-Lead configuration fields -->
          <input type="hidden" name="xnQsjsdp" value="5e1bc7ca8ff29b70e99dfe39a3191e2c32fc63b7a6770ecc115c3534725ba304" />
          <input type="hidden" name="xmIwtLD" value="b7f63ea911aba54798fb9e0c91813db48ccbc8973c654850e0620eb9fa2b2c9cb5c8dc20c0d46a922b4b63e2b42aca77" />
          <input type="hidden" name="actionType" value="TGVhZHM=" />
          <input type="hidden" name="returnURL" value="null" />
          <input type="hidden" name="zc_gad" id="zc_gad" value="" />
          <input type="hidden" name="LEADCF14" value="SmartMaps Pro" />
          <input type="hidden" name="Lead_Status" value="NO CONTACTADO" />
          <input type="hidden" name="Lead_Source" value="Pag, WEB smartmaps" />
          <input type="hidden" name="service" value="smarturl" />

          <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 16px;">
            <div style="grid-column: span 1;">
              <label style="font-size: 12px; font-weight: 700; margin-bottom: 6px; display: block;">
                {isEs ? 'Nombre' : 'First Name'} <span style="color: #D83B3B;">*</span>
              </label>
              <input
                type="text"
                name="firstName"
                required
                maxlength="40"
                placeholder={isEs ? 'Tu nombre' : 'Your first name'}
                style="width: 100%; height: 42px; padding: 0 12px; border: 1px solid #D2DCEE; border-radius: 6px; font-family: inherit; font-size: 14px; background: transparent;"
              />
            </div>

            <div style="grid-column: span 1;">
              <label style="font-size: 12px; font-weight: 700; margin-bottom: 6px; display: block;">
                {isEs ? 'Apellido' : 'Last Name'} <span style="color: #D83B3B;">*</span>
              </label>
              <input
                type="text"
                name="lastName"
                required
                maxlength="80"
                placeholder={isEs ? 'Tu apellido' : 'Your last name'}
                style="width: 100%; height: 42px; padding: 0 12px; border: 1px solid #D2DCEE; border-radius: 6px; font-family: inherit; font-size: 14px; background: transparent;"
              />
            </div>

            <div style="grid-column: span 2;">
              <label style="font-size: 12px; font-weight: 700; margin-bottom: 6px; display: block;">
                {isEs ? 'Empresa' : 'Company'} <span style="color: #D83B3B;">*</span>
              </label>
              <input
                type="text"
                name="company"
                required
                maxlength="200"
                placeholder={isEs ? 'Nombre de tu empresa' : 'Company name'}
                style="width: 100%; height: 42px; padding: 0 12px; border: 1px solid #D2DCEE; border-radius: 6px; font-family: inherit; font-size: 14px; background: transparent;"
              />
            </div>

            <div style="grid-column: span 2;">
              <label style="font-size: 12px; font-weight: 700; margin-bottom: 6px; display: block;">
                {isEs ? 'Correo corporativo' : 'Work Email'} <span style="color: #D83B3B;">*</span>
              </label>
              <input
                type="email"
                name="email"
                required
                maxlength="100"
                placeholder="nombre@empresa.com"
                style="width: 100%; height: 42px; padding: 0 12px; border: 1px solid #D2DCEE; border-radius: 6px; font-family: inherit; font-size: 14px; background: transparent;"
              />
            </div>

            <div style="grid-column: span 1;">
              <label style="font-size: 12px; font-weight: 700; margin-bottom: 6px; display: block;">
                {isEs ? 'País de origen' : 'Country of origin'} <span style="color: #D83B3B;">*</span>
              </label>
              <select
                name="country"
                required
                style="width: 100%; height: 42px; padding: 0 12px; border: 1px solid #D2DCEE; border-radius: 6px; font-family: inherit; font-size: 14px; background: #FFFFFF; color: #0A1C4E;"
              >
                <option value="">{isEs ? 'Selecciona un país' : 'Select a country'}</option>
                {countries.map((c) => (
                  <option value={c}>{c}</option>
                ))}
              </select>
            </div>

            <div style="grid-column: span 1;">
              <label style="font-size: 12px; font-weight: 700; margin-bottom: 6px; display: block;">
                {isEs ? 'Celular / WhatsApp' : 'Phone / WhatsApp'}
              </label>
              <input
                type="tel"
                name="phone"
                maxlength="30"
                placeholder="+57 300 000 0000"
                style="width: 100%; height: 42px; padding: 0 12px; border: 1px solid #D2DCEE; border-radius: 6px; font-family: inherit; font-size: 14px; background: transparent;"
              />
            </div>

            <div style="grid-column: span 2;">
              <label style="font-size: 12px; font-weight: 700; margin-bottom: 6px; display: block;">
                {isEs ? 'Comentarios / Requerimientos' : 'Comments / Requirements'} <span style="color: #D83B3B;">*</span>
              </label>
              <textarea
                name="details"
                required
                placeholder={
                  isEs
                    ? 'Cuéntanos qué desafío buscas resolver con SmartMaps...'
                    : 'Tell us about the challenge you are looking to solve with SmartMaps...'
                }
                style="width: 100%; height: 90px; padding: 12px; border: 1px solid #D2DCEE; border-radius: 6px; font-family: inherit; font-size: 14px; background: transparent; resize: vertical;"
              ></textarea>
            </div>

            <!-- Google reCAPTCHA v2 Oficial -->
            <div style="grid-column: span 2; display: flex; justify-content: center; margin-top: 6px; min-height: 78px;">
              <div class="g-recaptcha" data-sitekey="6LcUPforAAAAAEelfraIXxZHKVkW1HxgmqcBPb4N"></div>
            </div>

            <!-- Botón Submit -->
            <div style="grid-column: span 2; margin-top: 4px;">
              <button
                type="submit"
                style="width: 100%; height: 48px; border: none; border-radius: 9999px; background: #2E7CFF; color: #FFFFFF; font-family: inherit; font-weight: 600; font-size: 15px; cursor: pointer; display: flex; align-items: center; justify-content: center; transition: opacity 0.2s;"
              >
                {submitButtonText}
              </button>
            </div>

            <div
              class="form-feedback"
              style="grid-column: span 2; display: none; text-align: center; padding: 12px; border-radius: 6px; font-size: 14px; font-weight: 600;"
            ></div>
          </div>
        </form>
      </div>
    </div>
  </div>
</div>

<!-- Script oficial de Google reCAPTCHA v2 -->
<script src="https://www.google.com/recaptcha/api.js" async defer></script>

<!-- Scripts de Analytics y Seguimiento de Zoho CRM -->
<script is:inline src="https://crm.zohopublic.com/crm/WebFormServlet?rid=289429997ac54e1bfe437e0ebde469a8547d9dc332ea8eb9bb67e1bc53f25ffd"></script>
<script is:inline id="wf_anal" src="https://crm.zohopublic.com/crm/WebFormAnalyticsServeServlet?&tw=f11061c6dd17201b2ce59798b0c360a2354a1d30e6b05c5394587a6336b9acf4&version=v2"></script>

<script>
  document.querySelectorAll('.smartmaps-contact-form').forEach((form) => {
    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      const feedback = form.querySelector('.form-feedback') as HTMLElement;
      const submitBtn = form.querySelector('button[type="submit"]') as HTMLButtonElement;
      if (!feedback || !submitBtn) return;

      const isEn = document.documentElement.lang === 'en';

      // 1. Validar que el reCAPTCHA haya sido resuelto
      const recaptchaToken = (window as any).grecaptcha
        ? (window as any).grecaptcha.getResponse()
        : '';

      if (!recaptchaToken) {
        feedback.style.display = 'block';
        feedback.style.backgroundColor = '#FDF2F2';
        feedback.style.color = '#9B1C1C';
        feedback.textContent = isEn
          ? 'Please complete the reCAPTCHA verification before submitting.'
          : 'Por favor completa la verificación de reCAPTCHA antes de enviar.';
        return;
      }

      submitBtn.disabled = true;
      submitBtn.style.opacity = '0.7';
      feedback.style.display = 'none';

      try {
        const formData = new FormData(form as HTMLFormElement);
        const data = Object.fromEntries(formData.entries());

        const payload = {
          recaptchaToken,
          ...data,
          First_Name: data.firstName,
          Last_Name: data.lastName,
          Email: data.email,
          Company: data.company,
          Mobile: data.phone,
          LEADCF2: data.country,
          Description: data.details,
          LEADCF14: 'SmartMaps Pro',
          Lead_Status: 'NO CONTACTADO',
          Lead_Source: 'Pag, WEB smartmaps',
          xnQsjsdp: '5e1bc7ca8ff29b70e99dfe39a3191e2c32fc63b7a6770ecc115c3534725ba304',
          xmIwtLD: 'b7f63ea911aba54798fb9e0c91813db48ccbc8973c654850e0620eb9fa2b2c9cb5c8dc20c0d46a922b4b63e2b42aca77',
          actionType: 'TGVhZHM=',
          returnURL: 'null',
          zc_gad: (document.getElementById('zc_gad') as HTMLInputElement)?.value || '',
          service: 'smarturl'
        };

        const response = await fetch('/api/contact', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(payload),
        });

        if (response.ok) {
          // Push event to dataLayer for Google Tag Manager / Analytics
          (window as any).dataLayer = (window as any).dataLayer || [];
          (window as any).dataLayer.push({
            event: 'contact_form_submit',
            user_data: {
              email: data.email,
              phone: data.phone,
              firstName: data.firstName,
              lastName: data.lastName,
              company: data.company,
            },
          });

          feedback.style.display = 'block';
          feedback.style.backgroundColor = '#EBFBF2';
          feedback.style.color = '#1D7846';
          feedback.textContent = isEn
            ? 'Thank you! Your request has been successfully submitted. Our team will contact you shortly.'
            : '¡Gracias! Tu solicitud ha sido enviada con éxito. Nuestro equipo te contactará pronto.';

          (form as HTMLFormElement).reset();
          if ((window as any).grecaptcha) {
            (window as any).grecaptcha.reset();
          }
        } else {
          const errData = await response.json().catch(() => ({}));
          feedback.style.display = 'block';
          feedback.style.backgroundColor = '#FDF2F2';
          feedback.style.color = '#9B1C1C';
          feedback.textContent = errData.error || (isEn
            ? 'An error occurred while submitting. Please check your data and try again.'
            : 'Ocurrió un error al enviar el formulario. Por favor verifica tus datos e intenta nuevamente.');
          if ((window as any).grecaptcha) {
            (window as any).grecaptcha.reset();
          }
        }
      } catch (err) {
        feedback.style.display = 'block';
        feedback.style.backgroundColor = '#FDF2F2';
        feedback.style.color = '#9B1C1C';
        feedback.textContent = isEn
          ? 'Connection error. Please try again later.'
          : 'Error de conexión. Por favor intenta de nuevo más tarde.';
        if ((window as any).grecaptcha) {
          (window as any).grecaptcha.reset();
        }
      } finally {
        submitBtn.disabled = false;
        submitBtn.style.opacity = '1';
      }
    });
  });
</script>
