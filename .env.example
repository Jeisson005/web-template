# ==========================================
# General Project Configuration
# ==========================================
PORT=3000
PAYLOAD_SECRET=super-secret-payload-key-change-in-prod-12345

# ==========================================
# Database Configuration (SQLite default, or PostgreSQL)
# ==========================================
# For SQLite (default):
DATABASE_URI=file:/app/data/backend.db
# For PostgreSQL:
# DATABASE_URI=postgresql://user:password@host:5432/dbname

# ==========================================
# Asset Storage (Local volume default or Cloud S3 / R2)
# ==========================================
MEDIA_DIR=/app/media

# For Cloud Bucket Storage (AWS S3, Cloudflare R2, MinIO, Wasabi):
# S3_BUCKET=my-media-bucket
# S3_REGION=auto
# S3_ACCESS_KEY_ID=your_access_key
# S3_SECRET_ACCESS_KEY=your_secret_key
# S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
# S3_FORCE_PATH_STYLE=false

# ==========================
# Global Deployment Webhook
# ==========================
# Webhook dispatched by the "Deployment / Rebuild Site" CMS action:
# BUILD_WEBHOOK_URL=https://api.github.com/repos/user/repo/dispatches

# ==========================
# Astro Frontend Connectivity
# ==========================
PUBLIC_CMS_URL=http://localhost:3000
CMS_INTERNAL_URL=http://cms:3000
HOST=0.0.0.0
