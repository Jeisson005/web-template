# ==========================================
# General Project Configuration
# ==========================================
PORT=3000
PAYLOAD_SECRET=super-secret-payload-key-change-in-prod-12345

# ==========================================
# Database Configuration (SQLite default, or PostgreSQL)
# ==========================================
# For SQLite (default):
DATABASE_URI=file:/app/data/cms.db
# For PostgreSQL:
# DATABASE_URI=postgresql://user:password@host:5432/dbname

# ==========================================
# Asset Storage (FTP GoDaddy, Cloud S3 / R2, or Local volume)
# ==========================================
MEDIA_DIR=/app/media

# For FTP Storage (GoDaddy cPanel / Remote FTP):
# (If omitted, it can automatically inherit GODADDY_HOST, GODADDY_USER, GODADDY_PASSWORD)
# FTP_HOST=smartmaps360.ai
# FTP_USER=your_ftp_user
# FTP_PASSWORD=your_ftp_password
# FTP_PORT=21
# FTP_REMOTE_DIR=/media
# FTP_PUBLIC_URL=https://smartmaps360.ai/media

# For Cloud Bucket Storage (AWS S3, Cloudflare R2, MinIO, Wasabi):
# S3_BUCKET=my-media-bucket
# S3_REGION=auto
# S3_ACCESS_KEY_ID=your_access_key
# S3_SECRET_ACCESS_KEY=your_secret_key
# S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
# S3_FORCE_PATH_STYLE=false

# ==========================
# Global Deployment Webhook
# ==========================
# Webhook dispatched by the "Deployment / Rebuild Site" CMS action:
# BUILD_WEBHOOK_URL=https://api.github.com/repos/user/repo/dispatches

# ==========================
# Astro Frontend Connectivity
# ==========================
PUBLIC_CMS_URL=http://localhost:3000
CMS_INTERNAL_URL=http://cms:3000
HOST=0.0.0.0

# ==========================
# Security & Form Endpoints
# ==========================
PUBLIC_RECAPTCHA_SITE_KEY=your_recaptcha_site_key_here
RECAPTCHA_SECRET_KEY=your_recaptcha_secret_key_here
# Optional Zoho CRM overrides (If omitted, the form values or SmartMaps defaults are used)
# ZOHO_CRM_FORM_ID=your_zoho_form_id       # Alias xnQsjsdp
# ZOHO_CRM_FORM_TOKEN=your_zoho_form_token # Alias xmIwtLD
# ZOHO_CRM_XNQSJSDP=your_zoho_form_id
# ZOHO_CRM_XMIWTLD=your_zoho_form_token
# CONTACT_WEBHOOK_URL=https://hooks.zapier.com/...

